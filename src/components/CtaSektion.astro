---
/**
 * Avslutande CTA på undersidor.
 *
 * Låg tidigare som en rundad panel med radie 2rem och en stor streckad
 * siktglyf i hörnet. Både panelen och glyfen är borta: sektionen går nu i
 * full bredd som alla andra mörka sektioner, så att växlingen mörkt/ljust
 * bär rytmen i stället för att varje block ritar en egen ram.
 */
import { SITE, CTA, PHONE_HOURS } from '../lib/site';

interface Props {
  rubrik?: string;
  text?: string;
}

const {
  rubrik = 'Beskriv dina besvär för oss',
  text = 'Du behöver ingen remiss. Skriv några rader om vad du har för problem, vad du redan provat och vad du vill kunna göra igen — så tar vi ställning till om vi är rätt klinik för dig.',
} = Astro.props;
---

<section class="bg-djup px-5 py-(--spacing-rytm-vid) sm:px-8">
  <div class="mx-auto max-w-(--container-content)">
    <h2 class="t-h2 max-w-[16ch] text-papper">{rubrik}</h2>
    <p class="t-brod mt-8 max-w-(--container-läs) text-ljus-dov">{text}</p>

    <div class="mt-11 flex flex-wrap gap-3">
      <a href={CTA.primary.href} class="knapp knapp-ljus">{CTA.primary.label}</a>
      <a href={`mailto:${SITE.email}`} class="knapp knapp-kant-ljus">{SITE.email}</a>
    </div>

    <p class="t-liten mt-8 text-ljus-dov">
      Eller ring {SITE.phone} — telefontid {PHONE_HOURS.toLowerCase()}.
    </p>
  </div>
</section>
