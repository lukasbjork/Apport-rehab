---
/**
 * Kompakt kontaktremsa som läggs in mellan textavsnitt på långa sidor.
 *
 * Två syften på en gång: den ger en väg ut till kontakt var man än befinner
 * sig i texten, och den bryter upp långa textpartier så sidan andas.
 *
 * Medvetet INTE ett kort med ram — hårlinjer upptill och nedtill i stället,
 * så att den läser som en paus i flödet snarare än ännu en låda.
 */
import { SITE, CTA, PHONE_HOURS } from '../lib/site';

interface Props {
  /** Kort rad som ramar in varför man skulle höra av sig just här */
  text?: string;
  /** Mörk variant för placering mot mossa-djup */
  light?: boolean;
}

const {
  text = 'Osäker på om vi är rätt för dig? Skriv några rader så säger vi till.',
  light = false,
} = Astro.props;
---

<aside class="px-5 sm:px-8">
  <div
    class:list={[
      'mx-auto flex max-w-(--container-content) flex-col gap-6 border-y py-8 md:flex-row md:items-center md:justify-between md:gap-10',
      light ? 'border-papper/15' : 'border-linje',
    ]}
  >
    <div class="md:max-w-md">
      <p class:list={['text-[1.05rem] leading-snug', light ? 'text-papper' : 'text-djup']}>
        {text}
      </p>
      <p class:list={['mt-2 text-[0.88rem]', light ? 'text-papper/58' : 'text-dov']}>
        Inget remisstvång · Patientavgift {'200 kr'} · Frikort gäller
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-7 gap-y-3">
      <a
        href={`tel:${SITE.phoneHref}`}
        class:list={[
          'group inline-flex items-center gap-2.5 py-1',
          light ? 'text-papper' : 'text-djup',
        ]}
      >
        <span
          class:list={[
            'grid h-9 w-9 shrink-0 place-items-center rounded-full transition-colors',
            light
              ? 'bg-papper/10 text-papper group-hover:bg-papper/20'
              : 'bg-mellan text-lyft group-hover:bg-ljus-dov/40',
          ]}
        >
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <path
              d="M3.2 1.5h2.4l1.2 3-1.5 1.1a9 9 0 0 0 4.1 4.1l1.1-1.5 3 1.2v2.4a1.2 1.2 0 0 1-1.3 1.2A11.8 11.8 0 0 1 2 2.8a1.2 1.2 0 0 1 1.2-1.3Z"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span>
          <span class="lank-linje block text-[0.98rem] font-medium">{SITE.phone}</span>
          <span
            class:list={['block text-[0.8rem]', light ? 'text-papper/58' : 'text-dov']}
            >{PHONE_HOURS}</span
          >
        </span>
      </a>

      <a
        href={CTA.primary.href}
        class:list={[
          'rounded-full px-6 py-3 text-[0.93rem] font-medium transition-colors',
          light
            ? 'bg-papper text-djup hover:bg-mellan'
            : 'bg-lyft text-papper hover:bg-djup',
        ]}
      >
        {CTA.primary.label}
      </a>
    </div>
  </div>
</aside>
