---
/**
 * Besvär som rad, inte som kort.
 *
 * Var ett rundat kort med tonad yta och en accentlinje som växte fram vid
 * hover. Tio sådana i rutnät gjorde sidan till ett rutmönster av lådor med
 * identisk vikt. En hårlinjerad rad säger samma sak, tar en tredjedel så
 * mycket plats och låter rubriken bära.
 *
 * Gruppetiketten är borttagen: den upprepade sektionsrubriken ovanför.
 */
import type { Condition } from '../lib/content';

interface Props {
  condition: Condition;
  /**
   * Döljer teasern. Hubbsidan /besvar/ visar dem, för där är man för att
   * välja; i kortare listor blir tio teasrar en textvägg.
   */
  compact?: boolean;
}
const { condition, compact = false } = Astro.props;
---

<a
  href={`/besvar/${condition.slug}/`}
  class="rad group flex items-baseline justify-between gap-6 py-5 sm:px-2"
>
  <span>
    <span class="t-h3 block text-djup">{condition.name}</span>
    {!compact && <span class="t-liten mt-2 block max-w-prose text-dov">{condition.teaser}</span>}
  </span>
  <span
    aria-hidden="true"
    class="shrink-0 text-dov transition-transform duration-300 group-hover:translate-x-1"
  >
    <svg width="18" height="11" viewBox="0 0 15 10" fill="none">
      <path
        d="M0 5h13M9.5 1L13.5 5L9.5 9"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</a>
