---
import type { Condition } from '../lib/content';

interface Props {
  condition: Condition;
  /** Framhävt kort — spänner bredare i grid */
  wide?: boolean;
}
const { condition, wide = false } = Astro.props;
---

<a
  href={`/besvar/${condition.slug}/`}
  class:list={[
    'stig group relative flex flex-col justify-between rounded-2xl border border-sten bg-papper p-7 transition-all duration-300 hover:-translate-y-0.5 hover:border-salvia hover:shadow-mjuk',
    wide && 'sm:col-span-2',
  ]}
>
  <div>
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-salvia-text">
      {condition.group}
    </p>
    <h3 class="mt-3 text-[1.3rem] leading-snug text-mossa-djup">{condition.name}</h3>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-skiffer">{condition.teaser}</p>
  </div>

  <span
    class="mt-7 inline-flex items-center gap-2 text-[0.88rem] font-medium text-mossa transition-colors group-hover:text-tegel"
  >
    Läs mer
    <svg
      width="15"
      height="10"
      viewBox="0 0 15 10"
      fill="none"
      aria-hidden="true"
      class="transition-transform duration-300 group-hover:translate-x-1"
    >
      <path
        d="M0 5h13M9.5 1L13.5 5L9.5 9"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
