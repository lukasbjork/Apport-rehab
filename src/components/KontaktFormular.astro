---
/**
 * Kontaktformulär via Netlify Forms.
 *
 * Varför Netlify och inte Formspree: sajten hostas redan på Netlify, så
 * formulärhanteringen ingår utan tredjepart, utan API-nyckel och utan att
 * patientens uppgifter passerar ännu en leverantör. Gratisnivån räcker för
 * en klinik av den här storleken.
 *
 * Så fungerar det: Netlify hittar formuläret genom att läsa den publicerade
 * HTML:en vid deploy. Det kräver tre saker som är lätta att råka ta bort —
 *   1. `data-netlify="true"` på <form>
 *   2. dolt fält <input name="form-name"> med samma värde som form-name
 *   3. formuläret måste finnas i den statiska HTML:en, inte renderas av JS
 * Astro bygger statiskt, så punkt 3 är uppfylld.
 *
 * Inlämningar hamnar under Forms i Netlifys dashboard. Sätt upp
 * e-postavisering där, annars blir de liggande osedda.
 *
 * ── Integritet ────────────────────────────────────────────────
 * Formuläret är MEDVETET inte till för hälsouppgifter. En egenremiss ska
 * mejlas direkt till kliniken. Vi ber därför aldrig om personnummer, och
 * texten avråder från att skriva detaljer om hälsan här.
 */
import { SITE, PHONE_HOURS } from '../lib/site';

const falt =
  'w-full rounded-xl border border-linje bg-papper px-4 py-3 text-[0.98rem] text-djup transition-colors placeholder:text-dov/50 focus:border-lyft focus:outline-none';
const etikett = 'block text-[0.88rem] font-medium text-djup';
---

<form
  name="kontakt"
  method="POST"
  action="/tack/"
  data-netlify="true"
  netlify-honeypot="lamna-tom"
  class="space-y-5"
>
  <!-- Krävs av Netlify för att koppla inlämningen till rätt formulär -->
  <input type="hidden" name="form-name" value="kontakt" />

  <!-- Honungsfälla: dold för människor, ifylld av robotar -->
  <p class="hidden" aria-hidden="true">
    <label>Lämna det här fältet tomt: <input name="lamna-tom" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="namn" class={etikett}>
        Namn <span class="text-lera" aria-hidden="true">*</span>
      </label>
      <input
        id="namn"
        name="namn"
        type="text"
        required
        autocomplete="name"
        class={`mt-2 ${falt}`}
      />
    </div>
    <div>
      <label for="telefon" class={etikett}>Telefon</label>
      <input id="telefon" name="telefon" type="tel" autocomplete="tel" class={`mt-2 ${falt}`} />
    </div>
  </div>

  <div>
    <label for="epost" class={etikett}>
      E-post <span class="text-lera" aria-hidden="true">*</span>
    </label>
    <input
      id="epost"
      name="epost"
      type="email"
      required
      autocomplete="email"
      class={`mt-2 ${falt}`}
    />
  </div>

  <div>
    <label for="arende" class={etikett}>Vad gäller det?</label>
    <select id="arende" name="arende" class={`mt-2 ${falt}`}>
      <option>Fråga om utredning eller behandling</option>
      <option>Fråga om en bokad tid</option>
      <option>Återbud</option>
      <option>Fråga om kostnad</option>
      <option>Övrigt</option>
    </select>
  </div>

  <div>
    <label for="meddelande" class={etikett}>
      Meddelande <span class="text-lera" aria-hidden="true">*</span>
    </label>
    <textarea
      id="meddelande"
      name="meddelande"
      rows="6"
      required
      class={`mt-2 ${falt}`}
      aria-describedby="meddelande-hjalp"></textarea>
    <p id="meddelande-hjalp" class="mt-2 text-[0.86rem] leading-relaxed text-dov">
      Skriv inte personnummer eller detaljerade uppgifter om din hälsa här. Ska du skicka en
      egenremiss, mejla den direkt till <a
        href={`mailto:${SITE.email}`}
        class="lank-linje text-lyft">{SITE.email}</a
      >.
    </p>
  </div>

  <div class="flex items-start gap-3 rounded-xl border border-linje bg-papper/60 px-4 py-3.5">
    <input
      id="samtycke"
      name="samtycke"
      type="checkbox"
      required
      value="ja"
      class="mt-0.5 h-5 w-5 shrink-0 accent-[var(--color-lyft)]"
    />
    <label for="samtycke" class="text-[0.88rem] leading-relaxed text-dov">
      Jag samtycker till att Apport behandlar mina uppgifter för att kunna svara på mitt
      meddelande. Läs mer om <a href="/integritetspolicy/" class="lank-linje text-lyft"
        >hur vi hanterar personuppgifter</a
      >.
    </label>
  </div>

  <button
    type="submit"
    class="w-full rounded-full bg-lyft px-7 py-4 text-[0.98rem] font-medium text-papper transition-colors hover:bg-djup sm:w-auto"
  >
    Skicka meddelande
  </button>

  <p class="text-[0.86rem] leading-relaxed text-dov">
    Vill du hellre ringa? {SITE.phone}, telefontid {PHONE_HOURS.toLowerCase()}.
  </p>
</form>
