---
/**
 * Kontaktformulär.
 *
 * Formuläret är INAKTIVT tills SITE.formEndpoint fyllts i (Formspree e.dyl.).
 * Så länge det saknas visas mejl och telefon i stället för ett trasigt
 * formulär som tyst slänger patientens meddelande.
 */
import { SITE, PHONE_HOURS } from '../lib/site';

const aktivt = SITE.formEndpoint.length > 0;
const falt =
  'w-full rounded-xl border border-sten-mork bg-papper px-4 py-3 text-[0.95rem] text-grafit transition-colors placeholder:text-skiffer/50 focus:border-mossa focus:outline-none';
const etikett = 'block text-[0.86rem] font-medium text-mossa-djup';
---

{
  aktivt ? (
    <form action={SITE.formEndpoint} method="POST" class="space-y-5">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="namn" class={etikett}>
            Namn <span class="text-tegel">*</span>
          </label>
          <input id="namn" name="namn" type="text" required autocomplete="name" class={`mt-2 ${falt}`} />
        </div>
        <div>
          <label for="telefon" class={etikett}>
            Telefon
          </label>
          <input id="telefon" name="telefon" type="tel" autocomplete="tel" class={`mt-2 ${falt}`} />
        </div>
      </div>

      <div>
        <label for="epost" class={etikett}>
          E-post <span class="text-tegel">*</span>
        </label>
        <input id="epost" name="epost" type="email" required autocomplete="email" class={`mt-2 ${falt}`} />
      </div>

      <div>
        <label for="arende" class={etikett}>
          Ärende
        </label>
        <select id="arende" name="arende" class={`mt-2 ${falt}`}>
          <option>Fråga om utredning eller behandling</option>
          <option>Fråga om en bokad tid</option>
          <option>Återbud</option>
          <option>Övrigt</option>
        </select>
      </div>

      <div>
        <label for="meddelande" class={etikett}>
          Meddelande <span class="text-tegel">*</span>
        </label>
        <textarea id="meddelande" name="meddelande" rows="6" required class={`mt-2 ${falt}`} />
      </div>

      <p class="text-[0.84rem] leading-relaxed text-skiffer">
        Skicka inte personnummer eller detaljerade uppgifter om din hälsa via formuläret. Ska du
        skriva en egenremiss, mejla den direkt till{' '}
        <a href={`mailto:${SITE.email}`} class="lank-linje text-mossa">
          {SITE.email}
        </a>
        .
      </p>

      <button
        type="submit"
        class="rounded-full bg-mossa px-7 py-3.5 text-[0.95rem] font-medium text-kalk transition-colors hover:bg-mossa-djup"
      >
        Skicka meddelande
      </button>
    </form>
  ) : (
    <div class="rounded-2xl border border-sten bg-papper p-8">
      <h3 class="text-[1.2rem] text-mossa-djup">Hör av dig till oss</h3>
      <p class="mt-3 text-[0.98rem] leading-relaxed text-skiffer">
        Enklast når du oss på mejl. Skriv några rader om vad du behöver hjälp med, så återkommer vi.
      </p>

      <dl class="mt-7 space-y-5">
        <div>
          <dt class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-salvia-text">
            E-post
          </dt>
          <dd class="mt-1.5">
            <a
              href={`mailto:${SITE.email}`}
              class="lank-linje text-[1.05rem] font-medium text-mossa-djup"
            >
              {SITE.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-salvia-text">
            Telefon
          </dt>
          <dd class="mt-1.5">
            <a
              href={`tel:${SITE.phoneHref}`}
              class="lank-linje text-[1.05rem] font-medium text-mossa-djup"
            >
              {SITE.phone}
            </a>
            <span class="block text-[0.86rem] text-skiffer">Telefontid {PHONE_HOURS.toLowerCase()}</span>
          </dd>
        </div>
      </dl>

      <!--
        Till webbansvarig: formuläret aktiveras genom att fylla i SITE.formEndpoint
        i src/lib/site.ts (skapa en gratis endpoint på formspree.io). Tills dess
        visas kontaktuppgifterna ovan i stället för ett formulär som inte skickar.
      -->
    </div>
  )
}
