---
/**
 * Ultraljud som klinikens huvud-USP.
 *
 * Bygger på klinikens egna bilder (Wisonic Clover 60, stämplade "Apport AB").
 * Beskrivningen är grundad i /utredning/ och /kliniken/: ultraljud används
 * vid undersökning och blockader, "vilket höjer kvalitén och kan ge snabbt
 * svar avseende orsaken till din smärta".
 */
import Sikte from './Sikte.astro';

const punkter = [
  {
    rubrik: 'Vi ser vävnaden i rörelse',
    text: 'Röntgen och magnetkamera ger stillbilder. Med ultraljud kan vi se hur senor och muskler beter sig när leden faktiskt rör sig.',
  },
  {
    rubrik: 'Nålen hamnar där den ska',
    text: 'Vid blockader och injektioner följer vi nålen på skärmen medan den förs in. Det är skillnaden mellan att träffa rätt struktur och att hoppas.',
  },
  {
    rubrik: 'Svaret kommer ofta snabbare',
    text: 'Ibland ger undersökningen besked redan vid första besöket om vilken struktur som är inblandad.',
  },
];
---

<section class="relative overflow-hidden bg-djup px-5 py-(--spacing-rytm) sm:px-8">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-28 top-1/2 -translate-y-1/2 text-ljus-dov/8"
  >
    <Sikte size={420} dashed />
  </div>

  <div class="relative mx-auto max-w-(--container-content)">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-center">
      <!-- Bilden -->
      <div class="lg:col-span-6">
        <figure class="">
          <div class="overflow-hidden rounded-2xl border border-papper/12">
            <img
              src="/bilder/ultraljud-l5-s1.webp"
              alt="Ultraljudsbild tagen på Apport som visar vävnadslagren i nedre ländryggen, med markörer vid de strukturer som bedömts inför en blockad"
              width="640"
              height="430"
              loading="lazy"
              decoding="async"
              class="w-full"
            />
          </div>
          <figcaption class="mt-4 text-[0.85rem] leading-relaxed text-papper/58">
 Ultraljudsbild från kliniken, tagen vid en undersökning av nedre ländryggen.
            Markörerna pekar ut de strukturer som bedömts.
          </figcaption>
        </figure>
      </div>

      <!-- Texten -->
      <div class="lg:col-span-6">
        <p class="flex items-center gap-2.5 text-[0.76rem] font-semibold uppercase tracking-[0.16em] text-ljus-dov">
          <Sikte size={13} />
          Vårt viktigaste verktyg
        </p>

        <h2 class="mt-4 text-[clamp(1.9rem,3.6vw,2.8rem)] leading-[1.12] text-papper">
 Se problemet innan vi behandlar det
        </h2>

        <p class="mt-6 text-[1.06rem] leading-relaxed text-papper/72">
 Vid vissa smärttillstånd använder vi ultraljud för att undersöka specifika strukturer
 och vid behov vägleda diagnostiska blockader och behandling. Det höjer kvaliteten på
          undersökningen och kan ge snabbare svar på var smärtan kommer ifrån.
        </p>

        <ul class="mt-9 space-y-6">
          {
            punkter.map((p) => (
              <li class="flex gap-4">
                <span class="mt-1 shrink-0 text-ljus-dov">
                  <Sikte size={16} />
                </span>
                <div>
                  <h3 class="text-[1.05rem] leading-snug text-papper">{p.rubrik}</h3>
                  <p class="mt-1.5 text-[0.95rem] leading-relaxed text-papper/68">{p.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <a
          href="/behandlingar/utredning/"
          class="mt-10 inline-flex items-center gap-2.5 rounded-full border border-papper/25 px-7 py-3.5 text-[0.95rem] font-medium text-papper transition-colors hover:border-papper/60"
        >
          Läs om hur utredningen går till
          <svg width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
            <path
              d="M0 5h13M9.5 1L13.5 5L9.5 9"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
