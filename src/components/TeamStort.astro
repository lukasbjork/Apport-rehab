---
/**
 * Teamet med stora porträtt (§16).
 *
 * Två stora bilder i stället för kort med brödtext. Namn och roll under
 * bilden, meriterna som chips. Hover ger "Läs mer" över bilden.
 *
 * Saknas fotografier används BildPlatshallare i rätt proportion, så att
 * riktiga porträtt kan bytas in utan att layouten ändras.
 */
import BildPlatshallare from './BildPlatshallare.astro';
import { TEAM } from '../lib/content';
---

<section class="bg-kalk py-(--spacing-sek-lg)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="max-w-3xl">
      <p class="t-eyebrow stig text-salvia-text">Bakom Apport</p>
      <h2 class="t-statement stig mt-8 text-mossa-djup">
        Två personer.
        <span class="block text-salvia-text">Samma klinik sedan 2010.</span>
      </h2>
      <p class="t-brod stig-sen mt-10 max-w-lg text-skiffer">
        En läkare och en fysioterapeut, gifta med varandra. Du möter samma personer varje gång,
        och de pratar med varandra om ditt fall.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:mt-20 lg:gap-10">
      {
        TEAM.map((person) => (
          <article class="stig">
            <a href={`/om-apport/#${person.slug}`} class="group block">
              <div class="relative overflow-hidden rounded-sm">
                {person.image ? (
                  <img
                    src={person.image}
                    alt={person.imageAlt}
                    width="900"
                    height="1125"
                    loading="lazy"
                    decoding="async"
                    class="aspect-4/5 w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                ) : (
                  <BildPlatshallare
                    behov={`Porträtt av ${person.name}`}
                    monogram={person.name
                      .split(' ')
                      .map((n) => n[0])
                      .join('')}
                    ratio="aspect-4/5"
                  />
                )}

                <!-- Hover-överlägg -->
                <div class="pointer-events-none absolute inset-0 flex items-end bg-linear-to-t from-mossa-djup/80 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                  <span class="inline-flex items-center gap-2.5 p-7 text-[0.94rem] font-medium text-kalk">
                    Läs mer
                    <svg width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
                      <path
                        d="M0 5h13M9.5 1L13.5 5L9.5 9"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </div>
              </div>

              <h3 class="t-h2 mt-8 text-[clamp(1.5rem,2.4vw,2rem)] text-mossa-djup">
                {person.name}
              </h3>
              <p class="mt-2 text-[0.96rem] text-mossa-ljus">{person.role}</p>
            </a>

            <ul class="mt-5 flex flex-wrap gap-2">
              {person.specialties.map((sp) => (
                <li class="rounded-full border border-sten px-3.5 py-1.5 text-[0.8rem] text-skiffer">
                  {sp}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
