---
import Breadcrumbs from './Breadcrumbs.astro';
import Sikte from './Sikte.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  etikett?: string;
  rubrik: string;
  ingress?: string;
  crumbs: Crumb[];
}
const { etikett, rubrik, ingress, crumbs } = Astro.props;
---

<section class="relative overflow-hidden bg-djup px-5 pb-(--spacing-rytm) pt-10 sm:px-8">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-24 top-1/2 -translate-y-1/2 text-ljus-dov/10"
  >
    <Sikte size={340} dashed />
  </div>

  <div class="relative mx-auto max-w-(--container-content)">
    <Breadcrumbs {crumbs} light />

    <div class="mt-9 max-w-3xl">
      {
        etikett && (
          <p class="t-etikett text-ljus-dov">{etikett}</p>
        )
      }
      <h1
        class:list={['t-h2 text-papper', etikett && 'mt-8']}
      >
        {rubrik}
      </h1>
      {
        ingress && (
          <p class="t-brod mt-9 max-w-(--container-läs) text-papper/72">
            {ingress}
          </p>
        )
      }
    </div>
  </div>
</section>
