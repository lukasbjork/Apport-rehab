---
/**
 * Sidhuvud på undersidor.
 *
 * Den stora streckade siktcirkeln i bakgrunden är borttagen — den var ren
 * dekoration, och en mörk yta med en enda stor rubrik står starkare utan.
 * Etiketten är kvar som prop men sätts i gemener, inte versaler.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  etikett?: string;
  rubrik: string;
  ingress?: string;
  crumbs: Crumb[];
}
const { etikett, rubrik, ingress, crumbs } = Astro.props;
---

<section class="bg-djup px-5 pt-10 pb-(--spacing-rytm) sm:px-8">
  <div class="mx-auto max-w-(--container-content)">
    <Breadcrumbs {crumbs} light />

    <div class="mt-10 max-w-4xl">
      {etikett && <p class="t-etikett text-ljus-dov">{etikett}</p>}
      <h1 class:list={['t-h1 text-papper', etikett && 'mt-6']}>{rubrik}</h1>
      {
        ingress && (
          <p class="t-ingress mt-8 max-w-(--container-läs) text-ljus-dov">{ingress}</p>
        )
      }
    </div>
  </div>
</section>
