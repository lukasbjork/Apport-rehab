---
/**
 * Platshållare för foton som kliniken ska leverera.
 *
 * Designad för att se AVSIKTLIG ut, inte trasig: en tonad panel med
 * siktmotivet. Ingen "TODO"-text syns för besökaren — instruktionen
 * ligger i HTML-kommentar och i README.
 *
 * När ett riktigt foto finns: lägg filen i public/bilder/ och byt ut
 * komponenten mot en vanlig <img>. Bildytan har redan rätt proportion.
 */
import Sikte from './Sikte.astro';

interface Props {
  /** Vad för slags bild som ska in — syns bara i HTML-kommentaren */
  behov: string;
  /** Tailwind aspect-klass, t.ex. "aspect-4/5" */
  ratio?: string;
  class?: string;
  /** Initialer eller kort ordbild som visas i panelen */
  monogram?: string;
}

const { behov, ratio = 'aspect-4/5', class: className = '', monogram } = Astro.props;
---

<!-- Platshållare: se data-foto-saknas nedan för vilket foto som ska in. -->
<div
  class:list={[
    'relative grid place-items-center overflow-hidden rounded-2xl border border-sten bg-lind/50',
    ratio,
    className,
  ]}
  role="presentation"
  data-foto-saknas={behov}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-[0.5]"
    style="background-image: repeating-linear-gradient(115deg, transparent 0 22px, color-mix(in oklab, var(--color-salvia) 26%, transparent) 22px 23px);"
  >
  </div>

  <div class="relative flex flex-col items-center gap-3 text-mossa/45">
    <Sikte size={44} dashed />
    {
      monogram && (
        <span class="font-[family-name:var(--font-display)] text-[1.05rem] tracking-[0.14em] uppercase">
          {monogram}
        </span>
      )
    }
  </div>
</div>
