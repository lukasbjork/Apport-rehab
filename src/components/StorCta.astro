---
/**
 * Stor CTA-sektion (§19).
 *
 * Nästan affischlik: rubriken i display-storlek, mycket luft, och
 * kontaktuppgifterna utskrivna under knappen så att den som hellre ringer
 * eller mejlar slipper leta.
 *
 * Sand som botten i stället för grönt — sidan har redan två mörka sektioner,
 * och en tredje hade gjort avslutet tungt i stället för inbjudande.
 */
import { SITE, CTA, PHONE_HOURS } from '../lib/site';

interface Props {
  rubrik?: string;
  brod?: string;
}
const {
  rubrik = 'Berätta om dina besvär.',
  brod = 'Du behöver ingen remiss. Skriv några rader om vad du har för problem, vad du redan provat och vad du vill kunna göra igen.',
} = Astro.props;
---

<section class="bg-sand py-(--spacing-sek-xl)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <h2 class="t-statement stig max-w-[14ch] text-mossa-djup">{rubrik}</h2>

    <p class="t-brod stig-sen mt-10 max-w-xl text-mossa/80">{brod}</p>

    <div class="stig-sen mt-14">
      <a
        href={CTA.primary.href}
        class="group inline-flex items-center gap-3 rounded-full bg-mossa-djup px-10 py-5 text-[1.02rem] font-medium text-kalk transition-colors duration-300 hover:bg-mossa"
      >
        Skriv en egenremiss
        <svg
          width="16"
          height="11"
          viewBox="0 0 15 10"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1.5"
        >
          <path
            d="M0 5h13M9.5 1L13.5 5L9.5 9"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <dl
      class="mt-16 grid gap-8 border-t border-mossa/15 pt-10 sm:grid-cols-3 lg:mt-20"
    >
      <div>
        <dt class="t-eyebrow text-mossa">Telefon</dt>
        <dd class="mt-3">
          <a href={`tel:${SITE.phoneHref}`} class="lank-linje text-[1.15rem] text-mossa-djup"
            >{SITE.phone}</a
          >
          <span class="mt-1 block text-[0.86rem] text-mossa">Telefontid {PHONE_HOURS.toLowerCase()}</span>
        </dd>
      </div>
      <div>
        <dt class="t-eyebrow text-mossa">E-post</dt>
        <dd class="mt-3">
          <a
            href={`mailto:${SITE.email}`}
            class="lank-linje break-all text-[1.15rem] text-mossa-djup">{SITE.email}</a
          >
        </dd>
      </div>
      <div>
        <dt class="t-eyebrow text-mossa">Besöksadress</dt>
        <dd class="mt-3 text-[1.02rem] leading-relaxed text-mossa-djup">
          {SITE.street}<br />{SITE.postalCode}&nbsp;{SITE.city}
        </dd>
      </div>
    </dl>
  </div>
</section>
