---
/**
 * Stor CTA-sektion (§19).
 *
 * Nästan affischlik: rubriken i display-storlek, mycket luft, och
 * kontaktuppgifterna utskrivna under knappen så att den som hellre ringer
 * eller mejlar slipper leta.
 *
 * Mörk botten: sidan växlar nu mellan mörkt och ljust hela vägen ned, och
 * avslutet ska vara det tyngsta anslaget — inte det lättaste.
 *
 * Pilen inne i knappen är borttagen. En knapp som säger vad den gör behöver
 * ingen pil, och en pil fastklistrad i knapptexten är en av de tydligaste
 * mall-markörerna.
 */
import { SITE, CTA, PHONE_HOURS } from '../lib/site';

interface Props {
  rubrik?: string;
  brod?: string;
}
const {
  rubrik = 'Berätta om dina besvär.',
  brod = 'Du behöver ingen remiss. Skriv några rader om vad du har för problem, vad du redan provat och vad du vill kunna göra igen.',
} = Astro.props;
---

<section class="bg-djup py-(--spacing-rytm-vid)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <h2 class="t-h2 max-w-[14ch] text-papper">{rubrik}</h2>

    <p class="t-brod mt-10 max-w-(--container-läs) text-ljus-dov">{brod}</p>

    <div class="mt-14">
      <a href={CTA.primary.href} class="knapp knapp-ljus px-10 py-5 text-[1rem]">
        Skriv en egenremiss
      </a>
    </div>

    <dl
      class="mt-16 grid gap-8 border-t border-papper/15 pt-10 sm:grid-cols-3 lg:mt-20"
    >
      <div>
        <dt class="t-etikett text-ljus-dov">Telefon</dt>
        <dd class="mt-3">
          <a href={`tel:${SITE.phoneHref}`} class="lank-linje text-[1.15rem] text-papper"
            >{SITE.phone}</a
          >
          <span class="t-liten mt-1 block text-ljus-dov">Telefontid {PHONE_HOURS.toLowerCase()}</span>
        </dd>
      </div>
      <div>
        <dt class="t-etikett text-ljus-dov">E-post</dt>
        <dd class="mt-3">
          <a
            href={`mailto:${SITE.email}`}
            class="lank-linje break-all text-[1.15rem] text-papper">{SITE.email}</a
          >
        </dd>
      </div>
      <div>
        <dt class="t-etikett text-ljus-dov">Besöksadress</dt>
        <dd class="mt-3 text-[1.02rem] leading-relaxed text-papper">
          {SITE.street}<br />{SITE.postalCode}&nbsp;{SITE.city}
        </dd>
      </div>
    </dl>
  </div>
</section>
