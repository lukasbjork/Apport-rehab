---
/**
 * Fast CTA-rad i botten på mobil. Två val, eftersom kliniken tar emot
 * på två sätt: mejlad egenremiss eller telefon under telefontiden.
 * Döljs från lg och uppåt där headerns CTA alltid syns.
 */
import { SITE, CTA } from '../lib/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-linje bg-papper/95 backdrop-blur-md lg:hidden"
>
  <div class="mx-auto flex max-w-md gap-2.5 px-4 py-3">
    <a
      href={`tel:${SITE.phoneHref}`}
      class="flex flex-1 items-center justify-center gap-2 rounded-full border border-lyft px-4 py-3 text-[0.9rem] font-medium text-djup"
    >
      <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <path
          d="M3.2 1.5h2.4l1.2 3-1.5 1.1a9 9 0 0 0 4.1 4.1l1.1-1.5 3 1.2v2.4a1.2 1.2 0 0 1-1.3 1.2A11.8 11.8 0 0 1 2 2.8a1.2 1.2 0 0 1 1.2-1.3Z"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linejoin="round"></path>
      </svg>
      Ring
    </a>
    <a
      href={CTA.primary.href}
      class="flex flex-2 items-center justify-center rounded-full bg-lyft px-4 py-3 text-[0.9rem] font-medium text-papper"
    >
      {CTA.primary.label}
    </a>
  </div>
</div>
