---
/**
 * Redaktionell split-layout (§10).
 *
 * Bild i ena halvan, text i den andra — men avsiktligt osymmetriskt:
 * bilden går utanför containern mot skärmkanten och texten är indragen.
 * Det är skillnaden mellan en magasinuppslag och ett kort bredvid ett kort.
 */
interface Props {
  rubrik: string;
  stycken: string[];
  bild: { src: string; alt: string; caption?: string; w?: number; h?: number };
  cta?: { label: string; href: string };
  /** Bilden till höger i stället för vänster */
  omvand?: boolean;
}
const { rubrik, stycken, bild, cta, omvand = false } = Astro.props;
---

<section class="overflow-hidden bg-topp py-(--spacing-rytm-vid)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <!-- Bild -->
      <figure
        class:list={[
          ' lg:col-span-6',
          omvand ? 'lg:order-2 lg:-mr-16 xl:-mr-28' : 'lg:-ml-16 xl:-ml-28',
        ]}
      >
        <div class="y-ram">
          <img
            src={bild.src}
            alt={bild.alt}
            width={bild.w ?? 1400}
            height={bild.h ?? 1400}
            loading="lazy"
            decoding="async"
            class="w-full"
          />
        </div>
        {
          bild.caption && (
            <figcaption class="t-liten mt-4 max-w-md text-dov">
              {bild.caption}
            </figcaption>
          )
        }
      </figure>

      <!-- Text -->
      <div class:list={['lg:col-span-6', omvand ? 'lg:order-1' : '']}>
        <h2 class="t-h2 max-w-[16ch] text-djup">{rubrik}</h2>

        <div class="mt-8 space-y-5">
          {stycken.map((s) => <p class="t-brod max-w-(--container-läs) text-dov">{s}</p>)}
        </div>

        {
          cta && (
            <a
              href={cta.href}
              class="lank-linje mt-10 inline-block py-1 text-[0.95rem] font-medium text-lyft"
            >
              {cta.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
