---
/**
 * Redaktionell split-layout (§10).
 *
 * Bild i ena halvan, text i den andra — men avsiktligt osymmetriskt:
 * bilden går utanför containern mot skärmkanten och texten är indragen.
 * Det är skillnaden mellan en magasinuppslag och ett kort bredvid ett kort.
 */
interface Props {
  eyebrow: string;
  rubrik: string;
  stycken: string[];
  bild: { src: string; alt: string; caption?: string };
  cta?: { label: string; href: string };
  /** Bilden till höger i stället för vänster */
  omvand?: boolean;
}
const { eyebrow, rubrik, stycken, bild, cta, omvand = false } = Astro.props;
---

<section class="overflow-hidden bg-papper py-(--spacing-sek-lg)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <!-- Bild -->
      <figure
        class:list={[
          'stig lg:col-span-6',
          omvand ? 'lg:order-2 lg:-mr-16 xl:-mr-28' : 'lg:-ml-16 xl:-ml-28',
        ]}
      >
        <img
          src={bild.src}
          alt={bild.alt}
          width="1400"
          height="1050"
          loading="lazy"
          decoding="async"
          class="aspect-4/3 w-full rounded-sm object-cover"
        />
        {
          bild.caption && (
            <figcaption class="mt-4 max-w-md text-[0.84rem] leading-relaxed text-skiffer">
              {bild.caption}
            </figcaption>
          )
        }
      </figure>

      <!-- Text -->
      <div class:list={['lg:col-span-6', omvand ? 'lg:order-1' : '']}>
        <p class="t-eyebrow text-salvia-text">{eyebrow}</p>
        <h2 class="t-h2 mt-7 max-w-[16ch] text-mossa-djup">{rubrik}</h2>

        <div class="mt-8 space-y-5">
          {stycken.map((s) => <p class="t-brod max-w-lg text-skiffer">{s}</p>)}
        </div>

        {
          cta && (
            <a
              href={cta.href}
              class="group mt-10 inline-flex items-center gap-3 text-[0.98rem] font-medium text-mossa-djup"
            >
              <span class="lank-linje">{cta.label}</span>
              <svg width="16" height="11" viewBox="0 0 15 10" fill="none" aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1.5">
                <path d="M0 5h13M9.5 1L13.5 5L9.5 9" stroke="currentColor" stroke-width="1.3"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
