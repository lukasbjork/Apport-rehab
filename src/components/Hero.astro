---
/**
 * Hero — en skärm som gör en sak.
 *
 * Borttaget mot tidigare version:
 *  - Etiketten "Smärtspecialistklinik · Kristianstad". Logotypen säger redan
 *    samma sak två centimeter längre upp, och mittpricken var en AI-markör.
 *  - Bakgrundsbilden (ett patientfoto nedtonat till 11 %). Att använda
 *    klinikens starkaste tillgång som tapet är motsatsen till att visa den.
 *    Bilden är nu ledig och används i galleriet i stort format i stället.
 *  - Scroll-indikatorn.
 *
 * Kvar: rubriken, ultraljudsbilden, två knappar och trust-raden. Kontrasten
 * inne i rubriken görs med VIKT (300 mot 600), inte med färg — att färga en
 * enstaka rad i en rubrik är dekoration, inte hierarki.
 */
import { CTA, TRUST_POINTS } from '../lib/site';
---

<section class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden bg-djup pt-28 pb-12 lg:pt-32">
  <div class="mx-auto w-full max-w-(--container-content) px-5 sm:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <h1 class="t-display intro intro-1 text-papper">
          <span class="block font-light">Alla säger att det ser normalt ut.</span>
          <span class="mt-1 block">Ändå gör det ont.</span>
        </h1>

        <p class="t-ingress intro intro-2 mt-9 max-w-(--container-läs) text-ljus-dov">
          En bra behandling börjar inte alltid med en behandling. Den börjar
          med att ta reda på <em class="font-semibold not-italic text-papper">var</em> smärtan
          kommer ifrån.
        </p>

        <div class="intro intro-3 mt-11 flex flex-wrap gap-3">
          <a href={CTA.primary.href} class="knapp knapp-ljus">{CTA.primary.label}</a>
          <a href={CTA.secondary.href} class="knapp knapp-kant-ljus">{CTA.secondary.label}</a>
        </div>
      </div>

      <figure class="intro intro-4 lg:col-span-5">
        <div class="y-ram-mork">
          <img
            src="/bilder/ultraljud-c4-c5.webp"
            alt="Ultraljudsbild tagen på Apport som visar vävnadslagren i halsryggen, med markörer vid de strukturer som bedömts"
            width="640"
            height="430"
            class="w-full"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="t-liten mt-4 max-w-sm text-ljus-dov">
          Ultraljudsbild från kliniken — så avgör vi vilken struktur som bidrar till smärtan.
        </figcaption>
      </figure>
    </div>

    <!-- Trust-raden. Hårlinjeceller i stället för mittprickar. -->
    <ul
      class="intro intro-4 mt-16 grid grid-cols-2 gap-px border-t border-papper/12 bg-papper/12 sm:grid-cols-4"
    >
      {
        TRUST_POINTS.map((p) => (
          <li class="t-liten bg-djup pt-4 pr-4 text-ljus-dov sm:pt-5">{p}</li>
        ))
      }
    </ul>
  </div>
</section>
