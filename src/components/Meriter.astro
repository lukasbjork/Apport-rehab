---
/**
 * Credential-block. Endast verifierbara uppgifter — inga påhittade
 * patientantal, framgångssiffror eller betyg.
 * Källa: apport.rehab/om-oss/, /kliniken/ och allabolag.se.
 */
import { CREDENTIALS } from '../lib/content';

interface Props {
  /** Mörk variant för placering mot mossa-djup */
  light?: boolean;
}
const { light = false } = Astro.props;
---

<div>
  <ul class="grid gap-px overflow-hidden rounded-2xl bg-linje sm:grid-cols-2 lg:grid-cols-4">
    {
      CREDENTIALS.map((c) => (
        <li class:list={[' p-7', light ? 'bg-djup' : 'bg-topp']}>
          <p
            class:list={[
              'font-[family-name:var(--font-display)] text-[2.1rem] leading-none',
 light ? 'text-papper' : 'text-djup',
            ]}
          >
            {c.tal}
          </p>
          <p
            class:list={[
              'mt-3 text-[0.76rem] font-semibold uppercase tracking-[0.14em]',
 light ? 'text-ljus-dov' : 'text-dov',
            ]}
          >
            {c.etikett}
          </p>
          <p
            class:list={[
              'mt-2 text-[0.92rem] leading-relaxed',
 light ? 'text-papper/68' : 'text-dov',
            ]}
          >
            {c.text}
          </p>
        </li>
      ))
    }
  </ul>

</div>
