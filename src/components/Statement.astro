---
/**
 * Typografisk statement-sektion (§9).
 *
 * Ingen grid, inga kort, ingen bild. Bara en mycket stor rubrik och massor
 * av luft. Sektionen finns till för att bryta rytmen — det är den visuella
 * pausen som gör att resten inte läser som en mall.
 */
interface Props {
  eyebrow?: string;
  rubrik: string;
  /** Andra raden får accentfärg */
  rubrikAccent?: string;
  brod?: string;
  cta?: { label: string; href: string };
  light?: boolean;
}
const { eyebrow, rubrik, rubrikAccent, brod, cta, light = false } = Astro.props;
---

<section
  class:list={[
    'px-5 py-(--spacing-rytm-vid) sm:px-8',
 light ? 'bg-djup' : 'bg-papper',
  ]}
>
  <div class="mx-auto max-w-(--container-content)">
    {eyebrow && <p class:list={['t-etikett ', light ? 'text-ljus-dov' : 'text-dov']}>{eyebrow}</p>}

    <h2
      class:list={[
        't-h2  max-w-[19ch]',
 eyebrow && 'mt-9',
 light ? 'text-papper' : 'text-djup',
      ]}
    >
      {rubrik}
      {rubrikAccent && <span class:list={['block', light ? 'text-ljus-dov' : 'text-dov']}>{rubrikAccent}</span>}
    </h2>

    {
 brod && (
        <p
          class:list={[
            't-brod  mt-12 max-w-xl',
 light ? 'text-papper/70' : 'text-dov',
          ]}
        >
          {brod}
        </p>
      )
    }

    {
 cta && (
        <a
          href={cta.href}
          class:list={[
            ' group mt-12 inline-flex items-center gap-3 text-[1rem] font-medium',
 light ? 'text-papper' : 'text-djup',
          ]}
        >
          <span class="lank-linje">{cta.label}</span>
          <svg width="16" height="11" viewBox="0 0 15 10" fill="none" aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1.5">
            <path d="M0 5h13M9.5 1L13.5 5L9.5 9" stroke="currentColor" stroke-width="1.3"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      )
    }
  </div>
</section>
