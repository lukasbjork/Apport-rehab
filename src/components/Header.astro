---
import Logo from './Logo.astro';
import { SITE, NAV, CTA, PHONE_HOURS } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="sticky top-0 z-50">
  <!-- Toppremsa: telefon + telefontid. Sätter förväntan direkt. -->
  <div class="bg-mossa-djup text-kalk/85">
    <div
      class="mx-auto flex max-w-(--container-content) flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-2 text-[0.78rem] sm:px-8"
    >
      <p class="flex items-center gap-2">
        <span class="hidden sm:inline">Telefontid {PHONE_HOURS.toLowerCase()}</span>
        <a href={`tel:${SITE.phoneHref}`} class="lank-linje inline-block py-1 font-medium text-kalk">
          {SITE.phone}
        </a>
      </p>
      <p class="hidden md:block">Avtal med Region Skåne · patientavgift 200 kr · frikort gäller</p>
    </div>
  </div>

  <div class="border-b border-sten bg-kalk/92 backdrop-blur-md">
    <div
      class="mx-auto flex max-w-(--container-content) items-center justify-between gap-6 px-5 py-3.5 sm:px-8"
    >
      <a
        href="/"
        class="text-mossa-djup transition-opacity hover:opacity-70"
        aria-label="Apport — till startsidan"
      >
        <span class="hidden sm:block"><Logo variant="full" size={23} /></span>
        <span class="block sm:hidden"><Logo variant="kompakt" size={21} /></span>
      </a>

      <nav aria-label="Huvudmeny" class="hidden lg:block">
        <ul class="flex items-center gap-7 text-[0.9rem]">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'lank-linje py-1 transition-colors',
                    isActive(item.href)
                      ? 'text-mossa-djup font-medium'
                      : 'text-skiffer hover:text-mossa-djup',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={CTA.primary.href}
          class="hidden rounded-full bg-mossa px-5 py-2.5 text-[0.86rem] font-medium text-kalk transition-colors hover:bg-mossa-djup sm:inline-block"
        >
          {CTA.primary.label}
        </a>

        <!-- Mobilmeny: nativ details/summary, fungerar utan JavaScript -->
        <details class="group relative lg:hidden">
          <summary
            class="flex h-10 w-10 items-center justify-center rounded-full border border-sten-mork text-mossa-djup transition-colors hover:bg-lind"
            aria-label="Öppna meny"
          >
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
              <path
                d="M0 1h18M0 6h18M0 11h18"
                stroke="currentColor"
                stroke-width="1.5"
                class="group-open:hidden"></path>
              <path
                d="M2 1l14 10M16 1L2 11"
                stroke="currentColor"
                stroke-width="1.5"
                class="hidden group-open:block"></path>
            </svg>
          </summary>
          <nav
            aria-label="Mobilmeny"
            class="absolute right-0 top-13 w-64 rounded-2xl border border-sten bg-papper p-2 shadow-lyft"
          >
            <ul class="flex flex-col">
              {
                NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-xl px-4 py-3 text-[0.95rem] transition-colors hover:bg-lind',
                        isActive(item.href) ? 'text-mossa-djup font-medium' : 'text-skiffer',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li class="mt-1 border-t border-sten pt-2">
                <a
                  href={CTA.primary.href}
                  class="block rounded-xl bg-mossa px-4 py-3 text-center text-[0.95rem] font-medium text-kalk"
                >
                  {CTA.primary.label}
                </a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
