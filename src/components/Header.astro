---
/**
 * Flytande navbar.
 *
 * Ligger transparent ovanpå hero på startsidan och blir solid vid scroll.
 * Övriga sidor får solid direkt, eftersom de saknar mörk hero att ligga över.
 *
 * Pill-navigationen är borttagen. Länkarna står nu på egen linje med en
 * understrykning som växer — samma grepp som referensen, och ett mindre
 * rundat block på en sajt som hade för många.
 *
 * CTA:n är BESTÄNDIG i alla brytpunkter. Egenremissen är sajtens mål, och
 * den låg tidigare gömd bakom hamburgaren på små skärmar.
 */
import Logo from './Logo.astro';
import { SITE, NAV, CTA } from '../lib/site';

interface Props {
  /** true på sidor med mörk hero — navbaren startar transparent */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header
  id="toppnav"
  data-over-hero={overHero ? 'true' : 'false'}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-colors duration-500',
    overHero ? 'is-transparent' : 'is-solid',
  ]}
>
  <div
    class="mx-auto flex max-w-(--container-content) items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:py-5"
  >
    <a href="/" class="nav-logo transition-opacity hover:opacity-70">
      <span class="hidden sm:block"><Logo variant="full" size={21} /></span>
      <span class="block sm:hidden"><Logo variant="kompakt" size={19} /></span>
    </a>

    <nav aria-label="Huvudmeny" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'nav-lank lank-linje block py-1 text-[0.9rem] transition-colors duration-300',
                  isActive(item.href) && 'is-aktiv',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2.5">
      <!-- Beständig CTA. Kortas till ett verb på små skärmar, men försvinner aldrig. -->
      <a href={CTA.primary.href} class="nav-cta knapp knapp-sm">
        <span class="hidden sm:inline">{CTA.primary.label}</span>
        <span class="sm:hidden">Berätta</span>
      </a>

      <!-- Mobilmeny: nativ details/summary, fungerar utan JavaScript -->
      <details class="group relative lg:hidden">
        <summary
          class="nav-hamburgare flex h-11 w-11 items-center justify-center rounded-full transition-colors"
          aria-label="Öppna meny"
        >
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
            <path
              d="M0 1h18M0 6h18M0 11h18"
              stroke="currentColor"
              stroke-width="1.5"
              class="group-open:hidden"></path>
            <path
              d="M2 1l14 10M16 1L2 11"
              stroke="currentColor"
              stroke-width="1.5"
              class="hidden group-open:block"></path>
          </svg>
        </summary>
        <nav
          aria-label="Mobilmeny"
          class="y-platta absolute right-0 top-14 w-[16rem] border border-linje bg-topp p-1.5"
        >
          <ul class="flex flex-col">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block px-4 py-3.5 text-[0.98rem] transition-colors hover:bg-mellan',
                      isActive(item.href) ? 'font-medium text-djup' : 'text-dov',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-linje px-4 pb-1 pt-3.5">
              <a href={`tel:${SITE.phoneHref}`} class="block text-[0.9rem] text-dov">
                Ring {SITE.phone}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Transparent över mörk hero */
  #toppnav.is-transparent {
    color: var(--color-papper);
  }
  #toppnav.is-transparent .nav-lank {
    color: color-mix(in oklab, var(--color-papper) 74%, transparent);
  }
  #toppnav.is-transparent .nav-lank:hover,
  #toppnav.is-transparent .nav-lank.is-aktiv {
    color: var(--color-papper);
  }
  #toppnav.is-transparent .nav-lank.is-aktiv {
    background-size: 100% 1px;
  }
  #toppnav.is-transparent .nav-cta {
    background-color: var(--color-topp);
    color: var(--color-djup);
  }
  #toppnav.is-transparent .nav-cta:hover {
    background-color: var(--color-mellan);
  }
  #toppnav.is-transparent .nav-hamburgare {
    border: 1px solid color-mix(in oklab, var(--color-papper) 28%, transparent);
  }

  /* Solid — efter scroll, och direkt på undersidor */
  #toppnav.is-solid {
    background-color: color-mix(in oklab, var(--color-papper) 90%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-linje);
    color: var(--color-djup);
  }
  #toppnav.is-solid .nav-lank {
    color: var(--color-dov);
  }
  #toppnav.is-solid .nav-lank:hover,
  #toppnav.is-solid .nav-lank.is-aktiv {
    color: var(--color-djup);
  }
  #toppnav.is-solid .nav-lank.is-aktiv {
    background-size: 100% 1px;
    font-weight: 500;
  }
  #toppnav.is-solid .nav-cta {
    background-color: var(--color-lyft);
    color: var(--color-topp);
  }
  #toppnav.is-solid .nav-cta:hover {
    background-color: var(--color-djup);
  }
  #toppnav.is-solid .nav-hamburgare {
    border: 1px solid var(--color-linje);
  }
</style>

<script>
  /*
    Växlar navbaren till solid när hero passerats.
    Utan JS stannar den transparent över hero, vilket också fungerar —
    hero är mörk hela vägen ned.
  */
  const nav = document.getElementById('toppnav');
  if (nav && nav.dataset.overHero === 'true') {
    const brytpunkt = () => Math.max(window.innerHeight * 0.72, 320);
    let solid = false;
    const uppdatera = () => {
      const skaVaraSolid = window.scrollY > brytpunkt();
      if (skaVaraSolid === solid) return;
      solid = skaVaraSolid;
      nav.classList.toggle('is-solid', solid);
      nav.classList.toggle('is-transparent', !solid);
    };
    uppdatera();
    window.addEventListener('scroll', uppdatera, { passive: true });
    window.addEventListener('resize', uppdatera, { passive: true });
  }
</script>
