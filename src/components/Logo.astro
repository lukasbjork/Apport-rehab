---
/**
 * Ordbild + siktet som märke.
 * "Apport" är franska för "hämta tillbaka / bär fram" — därav den framåtriktade
 * tanken i märket: siktet som pekar in mot ordet.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-baseline gap-2.5 ${className}`}>
  <svg
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    aria-hidden="true"
    class="translate-y-[1px] shrink-0"
  >
    <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1" opacity="0.35" />
    <line x1="10" y1="1" x2="10" y2="5.5" stroke="currentColor" stroke-width="1.25" />
    <line x1="10" y1="14.5" x2="10" y2="19" stroke="currentColor" stroke-width="1.25" />
    <line x1="1" y1="10" x2="5.5" y2="10" stroke="currentColor" stroke-width="1.25" />
    <line x1="14.5" y1="10" x2="19" y2="10" stroke="currentColor" stroke-width="1.25" />
    <circle cx="10" cy="10" r="2.75" fill="currentColor" />
  </svg>
  <span
    class="font-[family-name:var(--font-display)] text-[1.35rem] leading-none tracking-[-0.03em]"
    >Apport</span
  >
</span>
