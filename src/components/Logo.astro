---
/**
 * Logotyp: redaktionell masthead.
 *
 * APPORT i Literata med öppen spärr, en hårlinje under, och underraden
 * SMÄRTSPECIALIST · KRISTIANSTAD.
 *
 * Underraden gör dubbel nytta: den är en del av märket och den talar om vad
 * kliniken är och var den finns — vilket är precis vad en förstagångsbesökare
 * behöver veta inom några sekunder. En ren ikon hade sagt ingenting av det.
 *
 * Formen valdes efter att tre bildmärken fallit: ultraljudssektorn blev en
 * varningstriangel i litet format, enbart bågar blev wifi-symbolen, och böjda
 * lager med punkt läste som ett slutet öga. En ordbild har inte det problemet
 * och passar dessutom en liten specialistklinik bättre än en ikon.
 *
 * variant="full"    header och footer på desktop
 * variant="kompakt" mobil och trånga ytor — underraden faller bort
 */
interface Props {
  variant?: 'full' | 'kompakt';
  /** Storlek på ordbilden i px */
  size?: number;
  class?: string;
}
const { variant = 'full', size = 23, class: className = '' } = Astro.props;
---

<span class={`inline-block leading-none ${className}`}>
  <span
    class="block font-[family-name:var(--font-display)] tracking-[0.075em]"
    style={`font-size:${size}px`}>APPORT</span
  >
  {
    variant === 'full' && (
      <span
        class="mt-[5px] block border-t border-current/25 pt-[4px] font-semibold tracking-[0.2em] opacity-80"
        style={`font-size:${Math.max(7.5, size * 0.37)}px`}
      >
        SMÄRTSPECIALIST · KRISTIANSTAD
      </span>
    )
  }
</span>
