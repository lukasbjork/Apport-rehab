---
/**
 * Långsamt horisontellt band (§22).
 *
 * Innehållet ligger dubblerat och animationen förflyttar exakt -50%, vilket
 * ger en sömlös loop utan hopp. Stannar helt vid prefers-reduced-motion.
 *
 * aria-hidden: det är dekor, och orden finns redan i sidans riktiga innehåll.
 * Skärmläsare ska inte läsa upp en oändlig ordslinga.
 */
interface Props {
  ord?: string[];
  /** Mörk variant */
  light?: boolean;
}
const {
 ord = ['Smärta', 'Utredning', 'Ultraljud', 'Blockad', 'Behandling', 'Rehabilitering', 'Kristianstad'],
 light = false,
} = Astro.props;

const serie = [...ord, ...ord];
---

<div
  aria-hidden="true"
  class:list={[
    'relative overflow-hidden border-y py-6',
 light ? 'border-papper/12 bg-djup' : 'border-linje bg-topp',
  ]}
>
  <div class="marquee">
    {
      serie.map((o) => (
        <span class="flex shrink-0 items-center">
          <span
            class:list={[
              'px-8 text-[0.9rem] uppercase tracking-[0.2em]',
 light ? 'text-papper/45' : 'text-dov/70',
            ]}
          >
            {o}
          </span>
          <span
            class:list={['h-1 w-1 rounded-full', light ? 'bg-ljus-dov/50' : 'bg-linje']}
          ></span>
        </span>
      ))
    }
  </div>

  <!-- Mjuk avtoning i kanterna -->
  <div
    class:list={[
      'pointer-events-none absolute inset-y-0 left-0 w-24',
 light ? 'bg-linear-to-r from-djup' : 'bg-linear-to-r from-topp',
    ]}
  >
  </div>
  <div
    class:list={[
      'pointer-events-none absolute inset-y-0 right-0 w-24',
 light ? 'bg-linear-to-l from-djup' : 'bg-linear-to-l from-topp',
    ]}
  >
  </div>
</div>
