---
/**
 * "Siktet" — sajtens signaturelement.
 * Ett hårfint hårkors med cirkel, hämtat från ultraljudsledd nålplacering.
 * Används som sektionsmarkör, listpunkt och i logotypen.
 */
interface Props {
  size?: number;
  class?: string;
  /** Ritar den yttre ringen streckad — används i större, dekorativa lägen */
  dashed?: boolean;
}

const { size = 16, class: className = '', dashed = false } = Astro.props;
const c = size / 2;
const r = size * 0.28;
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  fill="none"
  aria-hidden="true"
  class={className}
>
  <line x1={c} y1="0" x2={c} y2={size} stroke="currentColor" stroke-width="1" opacity="0.55" />
  <line x1="0" y1={c} x2={size} y2={c} stroke="currentColor" stroke-width="1" opacity="0.55" />
  <circle
    cx={c}
    cy={c}
    r={r}
    stroke="currentColor"
    stroke-width="1.25"
    fill="none"
    stroke-dasharray={dashed ? '2 3' : undefined}
  />
</svg>
