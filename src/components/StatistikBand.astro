---
/**
 * Statistikband med enorma siffror (§8).
 *
 * Ersätter det tidigare kortrutnätet. Siffrorna sätts i .t-siffra (upp till
 * 88px) och separeras av hårlinjer i stället för kortramar — det läser som
 * ett redaktionellt band, inte som fyra rutor.
 *
 * Endast verifierbara uppgifter. Inga påhittade patientantal.
 */
import { CREDENTIALS } from '../lib/content';
---

<section class="border-y border-linje bg-papper">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {
        CREDENTIALS.map((c, i) => (
          <div
            class:list={[
              ' border-linje py-10 sm:py-14',
 i % 2 === 1 && 'border-l pl-6 sm:pl-10',
 i % 2 === 0 && 'pr-6 sm:pr-10',
 i >= 2 && 'border-t lg:border-t-0',
 i > 0 && 'lg:border-l lg:pl-10',
 i < 3 && 'lg:pr-10',
            ]}
          >
            <dt class="sr-only">{c.etikett}</dt>
            <dd>
              <span class="t-siffra block text-djup">{c.tal}</span>
              <span class="t-etikett mt-5 block text-dov">{c.etikett}</span>
              <span class="mt-3 block max-w-[24ch] text-[0.9rem] leading-relaxed text-dov">
                {c.text}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
