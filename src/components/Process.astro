---
/**
 * Processen som sammanhängande tidslinje i stället för separata lådor.
 *
 * Tidigare låg stegen i ett gap-px-rutnät, vilket gjorde dem till separata
 * rutor utan samband. Nu binds de ihop av en hårlinje med noder, vilket både
 * ser mindre rutat ut och faktiskt visar att det är en kedja.
 *
 * Linjen ritas bara från lg och uppåt, och förutsätter att stegen ryms på EN
 * rad — vid radbrytning hamnar den fel. Därför lg och inte md: fem steg blir
 * för trångt vid 768 px. Under lg staplas stegen vertikalt med en lodrät linje
 * i stället. Lägger man till ett sjätte steg måste kolumnantalet följa med.
 */
import { PROCESS } from '../lib/content';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<ol class="relative grid gap-10 lg:grid-cols-5 lg:gap-6">
  <!-- Vågrät linje på md+ -->
  <div
    aria-hidden="true"
    class:list={[
      'absolute left-0 right-0 top-[11px] hidden h-px lg:block',
      light ? 'bg-papper/18' : 'bg-linje/60',
    ]}
  >
  </div>

  {
    PROCESS.map((step, i) => (
      <li class="relative">
        <!-- Lodrät linje på mobil, utom efter sista steget -->
        {i < PROCESS.length - 1 && (
          <div
            aria-hidden="true"
            class:list={[
              'absolute left-[11px] top-6 h-[calc(100%+2.5rem)] w-px lg:hidden',
              light ? 'bg-papper/18' : 'bg-linje/60',
            ]}
          />
        )}

        <div class="flex items-start gap-4 lg:block">
          <!-- Noden på linjen -->
          <span
            class:list={[
              'relative z-10 grid h-[23px] w-[23px] shrink-0 place-items-center rounded-full text-[0.68rem] font-semibold tabular-nums',
              light ? 'bg-ljus-dov text-djup' : 'bg-lyft text-papper',
            ]}
          >
            {i + 1}
          </span>

          <div class="lg:mt-6">
            <h3
              class:list={[
                't-h3',
                light ? 'text-papper' : 'text-djup',
              ]}
            >
              {step.title}
            </h3>
            <p
              class:list={[
                't-liten mt-2.5 lg:pr-4',
                light ? 'text-ljus-dov' : 'text-dov',
              ]}
            >
              {step.body}
            </p>
          </div>
        </div>
      </li>
    ))
  }
</ol>
