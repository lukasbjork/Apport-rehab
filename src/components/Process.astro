---
import { PROCESS } from '../lib/content';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<ol class="grid gap-px overflow-hidden rounded-2xl bg-sten sm:grid-cols-2 lg:grid-cols-4">
  {
    PROCESS.map((step) => (
      <li
        class:list={[
          'stig relative flex flex-col p-8',
          light ? 'bg-mossa-djup' : 'bg-papper',
        ]}
      >
        <span
          class:list={[
            'font-[family-name:var(--font-display)] text-[2.6rem] leading-none',
            light ? 'text-salvia/35' : 'text-sten-text',
          ]}
        >
          {step.number}
        </span>
        <h3
          class:list={[
            'mt-5 text-[1.18rem] leading-snug',
            light ? 'text-kalk' : 'text-mossa-djup',
          ]}
        >
          {step.title}
        </h3>
        <p
          class:list={[
            'mt-3 text-[0.94rem] leading-relaxed',
            light ? 'text-kalk/68' : 'text-skiffer',
          ]}
        >
          {step.body}
        </p>
      </li>
    ))
  }
</ol>
