---
/**
 * Processen som sammanhängande tidslinje i stället för fyra lådor.
 *
 * Tidigare låg stegen i ett gap-px-rutnät, vilket gjorde dem till fyra
 * separata rutor utan samband. Nu binds de ihop av en hårlinje med noder,
 * vilket både ser mindre rutat ut och faktiskt visar att det är en kedja.
 *
 * Linjen ritas bara från md och uppåt. På mobil staplas stegen vertikalt
 * med en lodrät linje i stället.
 */
import { PROCESS } from '../lib/content';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<ol class="relative grid gap-10 md:grid-cols-4 md:gap-8">
  <!-- Vågrät linje på md+ -->
  <div
    aria-hidden="true"
    class:list={[
      'absolute left-0 right-0 top-[11px] hidden h-px md:block',
 light ? 'bg-papper/18' : 'bg-linje/60',
    ]}
  >
  </div>

  {
    PROCESS.map((step, i) => (
      <li class="relative">
        <!-- Lodrät linje på mobil, utom efter sista steget -->
        {i < PROCESS.length - 1 && (
          <div
            aria-hidden="true"
            class:list={[
              'absolute left-[11px] top-6 h-[calc(100%+2.5rem)] w-px md:hidden',
 light ? 'bg-papper/18' : 'bg-linje/60',
            ]}
          />
        )}

        <div class="flex items-start gap-4 md:block">
          <!-- Noden på linjen -->
          <span
            class:list={[
              'relative z-10 grid h-[23px] w-[23px] shrink-0 place-items-center rounded-full text-[0.68rem] font-semibold tabular-nums',
 light ? 'bg-ljus-dov text-djup' : 'bg-lyft text-papper',
            ]}
          >
            {i + 1}
          </span>

          <div class="md:mt-6">
            <h3
              class:list={[
                'text-[1.16rem] leading-snug',
 light ? 'text-papper' : 'text-djup',
              ]}
            >
              {step.title}
            </h3>
            <p
              class:list={[
                'mt-2.5 text-[0.95rem] leading-relaxed md:pr-4',
 light ? 'text-papper/68' : 'text-dov',
              ]}
            >
              {step.body}
            </p>
          </div>
        </div>
      </li>
    ))
  }
</ol>
