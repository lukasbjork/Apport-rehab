---
/**
 * Patientfall.
 *
 * ⚠️ TOM MED FLIT. Komponenten renderar INGENTING så länge listan är tom.
 *
 * Ett patientfall är en beskrivning av en verklig patients förlopp och får
 * därför inte skrivas av någon annan än kliniken. Kraven innan ett fall
 * publiceras:
 *
 *  1. Skriftligt samtycke från patienten.
 *  2. Avidentifiering — ingen ålder + ort + diagnos i kombination som gör
 *     personen identifierbar i en mindre stad som Kristianstad.
 *  3. Rolf godkänner den medicinska beskrivningen.
 *  4. INGA garantier eller utfallslöften. Skriv "besvären minskade",
 *     inte "blev helt bra", "botad" eller "100 % återställd".
 *  5. Beskriv förloppet, inte resultatet: vad som gjordes och i vilken
 *     ordning — inte hur bra det gick.
 *
 * Strukturen nedan följer den kliniska kedjan: problem → utredning → fynd
 * → behandling → rehabilitering → uppföljning.
 */
import SektionsRubrik from './SektionsRubrik.astro';

interface Fall {
  /** T.ex. "Ländryggssmärta sedan tre år" */
  rubrik: string;
  /** Kort om vem, avidentifierat: "Man, 40-årsåldern" */
  patient: string;
  problem: string;
  utredning: string;
  fynd: string;
  behandling: string;
  rehabilitering: string;
  uppfoljning: string;
}

const FALL: Fall[] = [
  // Tomt tills kliniken levererat godkända, avidentifierade fall.
];

const steg: { nyckel: keyof Omit<Fall, 'rubrik' | 'patient'>; etikett: string }[] = [
  { nyckel: 'problem', etikett: 'Problem' },
  { nyckel: 'utredning', etikett: 'Utredning' },
  { nyckel: 'fynd', etikett: 'Vad vi hittade' },
  { nyckel: 'behandling', etikett: 'Behandling' },
  { nyckel: 'rehabilitering', etikett: 'Rehabilitering' },
  { nyckel: 'uppfoljning', etikett: 'Uppföljning' },
];
---

{
  FALL.length > 0 && (
    <section class="px-5 py-(--spacing-section) sm:px-8">
      <div class="mx-auto max-w-(--container-content)">
        <SektionsRubrik
          etikett="Patientfall"
          rubrik="Så kan ett förlopp se ut"
          ingress="Avidentifierade exempel, publicerade med patientens samtycke. Förloppen ser olika ut från person till person — det här är beskrivningar, inte löften om resultat."
        />

        <div class="mt-14 space-y-6">
          {FALL.map((fall) => (
            <article class="stig overflow-hidden rounded-2xl border border-sten bg-papper">
              <div class="border-b border-sten bg-lind/30 px-8 py-6">
                <h3 class="text-[1.3rem] leading-snug text-mossa-djup">{fall.rubrik}</h3>
                <p class="mt-1 text-[0.88rem] text-skiffer">{fall.patient}</p>
              </div>
              <ol class="grid gap-px bg-sten sm:grid-cols-2 lg:grid-cols-3">
                {steg.map((s, i) => (
                  <li class="bg-papper p-7">
                    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-salvia-text">
                      {String(i + 1).padStart(2, '0')} · {s.etikett}
                    </p>
                    <p class="mt-3 text-[0.94rem] leading-relaxed text-skiffer">
                      {fall[s.nyckel]}
                    </p>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
