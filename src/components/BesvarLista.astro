---
/**
 * Besvär som numrerad redaktionell lista (§12).
 *
 * Ersätter kortrutnätet. Varje rad är ett stort typografiskt anslag med
 * löpnummer; vid hover expanderar raden, bakgrunden skiftar och pilen rör
 * sig. Ett bildfönster till höger visar besvärets bild när raden hovras.
 *
 * Bildvisningen är ren CSS via :hover på raden och general sibling —
 * ingen JavaScript. På touch (där hover inte finns) visas ingen bild, vilket
 * är rätt: där ska listan bara vara snabb att skanna och tumvänlig.
 */
import { CONDITIONS } from '../lib/content';

const medBild = CONDITIONS.filter((c) => c.image);
---

<section class="bg-kalk py-(--spacing-sek-lg)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div>
        <p class="t-eyebrow text-salvia-text">Besvär</p>
        <h2 class="t-h2 mt-7 max-w-[15ch] text-mossa-djup">
          Vilken typ av smärta söker du hjälp för?
        </h2>
      </div>
      <a
        href="/besvar/"
        class="lank-linje pb-1 text-[0.94rem] font-medium text-mossa">Alla besvär →</a
      >
    </div>

    <div class="mt-16 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- Listan -->
      <ol class="besvar-lista lg:col-span-7">
        {
          CONDITIONS.map((c, i) => (
            <li class="border-t border-sten last:border-b" data-bild={c.image?.src ?? ''}>
              <a
                href={`/besvar/${c.slug}/`}
                class="rad-besvar group flex items-baseline gap-5 py-6 sm:gap-8 sm:py-7"
              >
                <span class="w-7 shrink-0 text-[0.82rem] tabular-nums text-salvia-text">
                  {String(i + 1).padStart(2, '0')}
                </span>

                <span class="t-h3 flex-1 text-mossa-djup transition-colors duration-300 group-hover:text-mossa">
                  {c.name}
                </span>

                <span
                  aria-hidden="true"
                  class="shrink-0 text-sten-mork transition-all duration-300 group-hover:translate-x-1 group-hover:text-mossa"
                >
                  <svg width="20" height="12" viewBox="0 0 15 10" fill="none">
                    <path d="M0 5h13M9.5 1L13.5 5L9.5 9" stroke="currentColor" stroke-width="1.2"
                      stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <!-- Bildfönster. Endast dekor — listan bär all information. -->
      <div aria-hidden="true" class="hidden lg:col-span-5 lg:block">
        <div class="sticky top-32 aspect-4/5 overflow-hidden rounded-sm bg-lind/40">
          {
            medBild.map((c, i) => (
              <img
                src={c.image!.src}
                alt=""
                loading="lazy"
                decoding="async"
                data-besvar={c.slug}
                class:list={[
                  'besvar-bild absolute inset-0 h-full w-full object-cover transition-opacity duration-500',
                  i === 0 ? 'opacity-100' : 'opacity-0',
                ]}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Bildfönstret behöver en positionerad förälder för de absolut lagda bilderna */
  .besvar-bild { position: absolute; }
</style>

<script>
  /*
    Byter bild i fönstret när en rad hovras eller fokuseras.
    Fokus räknas också, så att tangentbordsnavigering ger samma återkoppling.
    Utan JS ligger första bilden kvar — sidan fungerar ändå.
  */
  const lista = document.querySelector('.besvar-lista');
  const bilder = [...document.querySelectorAll<HTMLImageElement>('.besvar-bild')];

  if (lista && bilder.length) {
    const visa = (slug: string | null) => {
      if (!slug) return;
      let traff = false;
      for (const b of bilder) {
        const matchar = b.dataset.besvar === slug;
        if (matchar) traff = true;
        b.style.opacity = matchar ? '1' : '0';
      }
      // Har raden ingen egen bild låter vi den förra ligga kvar
      if (!traff) return;
    };

    for (const rad of lista.querySelectorAll('a[href]')) {
      const slug = rad.getAttribute('href')?.split('/').filter(Boolean).pop() ?? null;
      rad.addEventListener('mouseenter', () => visa(slug));
      rad.addEventListener('focus', () => visa(slug));
    }
  }
</script>
