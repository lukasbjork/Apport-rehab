---
/**
 * Besvär som hårlinjelista i två spalter.
 *
 * Två saker är borttagna:
 *
 *  - NUMRERINGEN 01–10. Listan är inte en sekvens — man har inte
 *    ryggsmärta före nacksmärta. Numrering ska bara finnas där innehållet
 *    faktiskt är en ordningsföljd, och på den här sidan är det bara
 *    fyrastegsprocessen.
 *
 *  - BILDFÖNSTRET till höger. Det visade en bild först vid hover, vilket
 *    innebar att en stor grå ruta stod tom på halva bredden vid sidladdning
 *    och alltid var tom på touch. Utrymmet används bättre till en andra
 *    spalt, så att hela listan syns utan att man scrollar förbi den.
 *
 * Kvar: raderna, som nu är kompakta och snabba att skanna.
 */
import { CONDITIONS } from '../lib/content';
---

<section class="bg-mellan/45 py-(--spacing-rytm)">
  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="t-h2 max-w-[15ch] text-djup">Vilken typ av smärta söker du hjälp för?</h2>
      <a href="/besvar/" class="lank-linje py-1 text-[0.95rem] font-medium text-lyft">
        Alla besvär
      </a>
    </div>

    <ul class="mt-12 border-t border-djup/15 sm:columns-2 sm:gap-x-12 lg:mt-14">
      {
        CONDITIONS.map((c) => (
          <li class="break-inside-avoid border-b border-djup/15">
            <a
              href={`/besvar/${c.slug}/`}
              class="rad group flex items-center justify-between gap-5 py-5 sm:px-2"
            >
              <span class="t-h3 text-djup">{c.name}</span>
              <span
                aria-hidden="true"
                class="shrink-0 text-dov transition-transform duration-300 group-hover:translate-x-1"
              >
                <svg width="18" height="11" viewBox="0 0 15 10" fill="none">
                  <path
                    d="M0 5h13M9.5 1L13.5 5L9.5 9"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
