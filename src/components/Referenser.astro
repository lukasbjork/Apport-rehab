---
/**
 * Patientomdömen från Google.
 *
 * ⚠️ LÄS INNAN DU FYLLER I
 * Nuvarande apport.rehab har en referenssektion som ligger live med lorem
 * ipsum och påhittade namn ("Tobias – CEO", "Jimmy", "Alice", "Adam").
 * Därför renderar den här komponenten INGENTING så länge GOOGLE är null —
 * det går inte att råka publicera platshållare eller påhittade betyg.
 *
 * ── Så fyller du i ───────────────────────────────────────────────
 * Öppna klinikens Google-profil, och för in siffrorna EXAKT som de står
 * där. Skriv aldrig av ur minnet och avrunda inte uppåt.
 *
 * snitt   → snittbetyget, t.ex. 4.8
 * antal   → antal omdömen
 * url     → länk till den publika omdömessidan, så att besökaren kan
 * kontrollera uppgiften själv
 * omdomen → enskilda omdömen, ordagrant. Korta INTE ner ett omdöme så
 * att innebörden ändras. Vill du korta, klipp i slutet och
 * avsluta med "…", aldrig i mitten.
 *
 * Namn: använd det namn recensenten själv publicerat på Google. Hitta
 * aldrig på ett namn och lägg aldrig till efternamn som inte står där.
 *
 * ── Underhåll ────────────────────────────────────────────────────
 * Betyget ändras över tid. Ett inaktuellt snittbetyg på sajten är sämre
 * än inget alls, och AggregateRating-schema med fel siffror är dessutom
 * något Google utfärdar manuella åtgärder för. Stäm av vid varje större
 * uppdatering av sajten.
 */
import SektionsRubrik from './SektionsRubrik.astro';
import { SITE } from '../lib/site';

interface Omdome {
  /** Recensentens egna ord, ordagrant */
  text: string;
  /** Namnet som står på Google */
  namn: string;
  /** Betyg 1–5 som recensenten satt */
  betyg: number;
  /** Valfritt: "för 2 månader sedan" eller ett datum */
  when?: string;
  /**
   * true om Google bara visade en del av texten. Kortet får då en rad om
   * att omdömet är avkortat, så att ingen tror att citatet är fullständigt.
   */
  avkortat?: boolean;
}

interface GoogleOmdomen {
  snitt: number;
  antal: number;
  url: string;
  omdomen: Omdome[];
}

/**
 * Avläst från klinikens Google-profil 2026-09-01.
 *
 * 7 omdömen, samtliga 5/5. Fyra har text, tre är enbart betyg — de sistnämnda
 * räknas in i snittet men har inget att visa, så de finns inte som kort.
 *
 * Jo Bodens omdöme är AVKORTAT. Google visade bara början följt av "… Mer",
 * och sidan går inte att läsa automatiserat. Texten återges ordagrant så
 * långt den var synlig och avslutas med "…". Den som vill läsa hela klickar
 * sig vidare via länken. Gissa aldrig hur ett omdöme slutar.
 *
 * Stäm av siffrorna vid varje större uppdatering — ett inaktuellt snittbetyg
 * är sämre än inget alls, särskilt när det ligger i AggregateRating-schemat.
 */
const GOOGLE: GoogleOmdomen | null = {
  snitt: 5.0,
  antal: 7,
  url: 'https://www.google.com/search?q=Apport+AB+Recensioner',
  omdomen: [
    {
      text:
        'Som patient med ryggsmärta efter steloperationer sedan många år är jag så tacksam att ha hittat någon som verkar uppriktigt intresserad av att söka efter något …',
      namn: 'Jo Boden',
      betyg: 5,
      when: 'för 3 år sedan',
      avkortat: true,
    },
    {
      text: 'Underbar förstående läkare och övrig personal.',
      namn: 'Bing Boström',
      betyg: 5,
      when: 'för 5 år sedan',
    },
    {
      text: 'Helt klart de bästa',
      namn: 'Eva Ohlsson',
      betyg: 5,
      when: 'för 2 månader sedan',
    },
    {
      text: 'Dom bästa ❤️',
      namn: 'Kerstin Wallander Jansson',
      betyg: 5,
      when: 'för 3 år sedan',
    },
  ],
};

const stjarnor = (n: number) => Math.round(n);
---

{
 GOOGLE && (
    <section class="px-5 py-(--spacing-rytm) sm:px-8" aria-labelledby="omdomen-rubrik">
      <div class="mx-auto max-w-(--container-content)">
        <SektionsRubrik
          etikett="Patientröster"
          rubrik="Vad patienter säger"
          align="center"
        />

        {/* Sammanfattning */}
        <a
          href={GOOGLE.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mx-auto mt-12 flex w-fit items-center gap-5 rounded-2xl bg-topp px-8 py-5"
        >
          <span class="font-[family-name:var(--font-display)] text-[2.4rem] leading-none text-djup">
            {GOOGLE.snitt.toFixed(1).replace('.', ',')}
          </span>
          <span>
            <span class="flex gap-0.5" aria-hidden="true">
              {Array.from({ length: 5 }, (_, i) => (
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M8 1.6l1.85 3.75 4.15.6-3 2.93.71 4.12L8 11.05l-3.71 1.95.71-4.12-3-2.93 4.15-.6z"
                    fill={i < stjarnor(GOOGLE.snitt) ? 'var(--color-lera)' : 'var(--color-linje)'}
                  />
                </svg>
              ))}
            </span>
            <span class="mt-1.5 block text-[0.9rem] text-dov">
              {GOOGLE.antal} omdömen på Google · läs alla
            </span>
          </span>
        </a>

        {/* Enskilda omdömen */}
        {GOOGLE.omdomen.length > 0 && (
          <ul class="mx-auto mt-14 grid max-w-4xl items-start gap-6 sm:grid-cols-2">
            {GOOGLE.omdomen.map((o) => (
              <li>
                <figure class="flex h-full flex-col rounded-2xl bg-topp p-8">
                  <div class="flex gap-0.5" aria-label={`${o.betyg} av 5`}>
                    {Array.from({ length: 5 }, (_, i) => (
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M8 1.6l1.85 3.75 4.15.6-3 2.93.71 4.12L8 11.05l-3.71 1.95.71-4.12-3-2.93 4.15-.6z"
                          fill={i < o.betyg ? 'var(--color-lera)' : 'var(--color-linje)'}
                        />
                      </svg>
                    ))}
                  </div>

                  <blockquote class="mt-5 flex-1 text-[1.01rem] leading-relaxed text-djup">
                    <p>”{o.text}”</p>
                  </blockquote>

                  <figcaption class="mt-6 border-t border-linje pt-5 text-[0.86rem]">
                    <span class="font-medium text-djup">{o.namn}</span>
                    {o.when && <span class="block text-dov">{o.when}</span>}
                    {o.avkortat && (
                      <a
                        href={GOOGLE.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="lank-linje mt-1.5 inline-block text-[0.82rem] text-lyft"
                      >
 Avkortat — läs hela på Google
                      </a>
                    )}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}

        <p class="mt-10 text-center text-[0.86rem] text-dov">
          Omdömena är hämtade från Google och publicerade av patienterna själva.
        </p>
      </div>

      {/*
 AggregateRating publiceras BARA när det finns verkliga, publikt
 kontrollerbara omdömen. Falsk recensionsmarkering är en av de saker
 Google uttryckligen utfärdar manuella åtgärder för.
      */}
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'MedicalClinic',
          '@id': `${SITE.url}/#klinik`,
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: GOOGLE.snitt,
            reviewCount: GOOGLE.antal,
            bestRating: 5,
            worstRating: 1,
          },
          // Avkortade omdömen utelämnas ur schemat — reviewBody ska vara
          // recensentens fullständiga text, inte ett utdrag.
          review: GOOGLE.omdomen
            .filter((o) => !o.avkortat)
            .map((o) => ({
              '@type': 'Review',
              reviewRating: { '@type': 'Rating', ratingValue: o.betyg, bestRating: 5 },
              author: { '@type': 'Person', name: o.namn },
              reviewBody: o.text,
            })),
        })}
      />
    </section>
  )
}
