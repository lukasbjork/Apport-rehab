---
/**
 * Sektionsrubrik.
 *
 * Etiketten satt tidigare i versaler med en siktglyf framför. Båda är borta:
 * versaletiketter ovanför varje rubrik var sajtens tydligaste mallsignal, och
 * glyfen var dekoration. Etiketten finns kvar som prop men ska bara användas
 * där den faktiskt tillför något rubriken inte redan säger.
 */
interface Props {
  /** Liten etikett ovanför rubriken. Använd sparsamt. */
  etikett?: string;
  rubrik: string;
  /** Ingresstext under rubriken */
  ingress?: string;
  /** h2 som standard; h1 på sidor där sektionen är huvudrubriken */
  as?: 'h1' | 'h2';
  align?: 'left' | 'center';
  light?: boolean;
  class?: string;
}

const {
  etikett,
  rubrik,
  ingress,
  as: Tag = 'h2',
  align = 'left',
  light = false,
  class: className = '',
} = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl', className]}>
  {
    etikett && (
      <p class:list={['t-etikett', light ? 'text-ljus-dov' : 'text-dov']}>{etikett}</p>
    )
  }
  <Tag
    class:list={[
      Tag === 'h1' ? 't-h1' : 't-h2',
      etikett && 'mt-5',
      light ? 'text-papper' : 'text-djup',
    ]}
  >
    {rubrik}
  </Tag>
  {
    ingress && (
      <p class:list={['t-brod mt-6 max-w-(--container-läs)', light ? 'text-ljus-dov' : 'text-dov']}>
        {ingress}
      </p>
    )
  }
</div>
