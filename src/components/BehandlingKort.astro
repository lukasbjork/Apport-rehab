---
/**
 * Behandlingskort.
 *
 * Bilden är kvar — behandlingssidorna har riktiga kliniska foton och de ska
 * synas. Det som är borta är kortchromet: radien 2rem, accentlinjen vid
 * hover, zoom-effekten på bilden och de två versalchipsen. Kvar är en ram
 * runt bilden och text på hårlinje.
 */
import type { Treatment } from '../lib/content';

interface Props {
  treatment: Treatment;
}
const { treatment } = Astro.props;
---

<a href={`/behandlingar/${treatment.slug}/`} class="group flex h-full flex-col">
  {
    treatment.image && (
      <div class="y-ram">
        <img
          src={treatment.image.src}
          alt={treatment.image.alt}
          width="1400"
          height="875"
          loading="lazy"
          decoding="async"
          class="aspect-16/10 w-full object-cover"
        />
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col border-t border-linje pt-5', treatment.image && 'mt-6']}>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {treatment.regenerative && <span class="t-liten text-dov">Regenerativ</span>}
      {!treatment.inAgreement && <span class="t-liten text-lera">Utanför avtalet</span>}
    </div>

    <h3 class:list={['t-h3 text-djup', (treatment.regenerative || !treatment.inAgreement) && 'mt-2']}>
      {treatment.name}
    </h3>
    <p class="t-liten mt-3 flex-1 text-dov">{treatment.teaser}</p>

    <span class="lank-linje mt-6 inline-block w-fit py-1 text-[0.9rem] font-medium text-lyft">
      Läs mer
    </span>
  </div>
</a>
