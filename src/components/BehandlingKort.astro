---
import type { Treatment } from '../lib/content';

interface Props {
  treatment: Treatment;
}
const { treatment } = Astro.props;
---

<a
  href={`/behandlingar/${treatment.slug}/`}
  class="group relative flex flex-col overflow-hidden rounded-2xl bg-topp transition-all duration-300"
>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-10 h-[2px] origin-left scale-x-0 bg-lyft transition-transform duration-400 ease-out group-hover:scale-x-100"
  ></span>

  {
    treatment.image && (
      <div class="aspect-16/10 overflow-hidden rounded-t-2xl bg-mellan">
        <img
          src={treatment.image.src}
          alt={treatment.image.alt}
          width="1400"
          height="875"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    )
  }

  <div class="flex flex-col p-7">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        {
          treatment.regenerative && (
            <span class="rounded-full bg-mellan px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-lyft">
              Regenerativ
            </span>
          )
        }
        {
          !treatment.inAgreement && (
            <span class="rounded-full bg-lera/10 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-lera">
              Utanför avtalet
            </span>
          )
        }
      </div>

      <h3 class="mt-3.5 text-[1.28rem] leading-snug text-djup">{treatment.name}</h3>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-dov">{treatment.teaser}</p>
    </div>

    <span
      class="mt-6 inline-flex items-center gap-2 text-[0.88rem] font-medium text-lyft transition-colors group-hover:text-lera"
    >
      Läs mer
      <svg
        width="15"
        height="10"
        viewBox="0 0 15 10"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-300 group-hover:translate-x-1"
      >
        <path
          d="M0 5h13M9.5 1L13.5 5L9.5 9"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>
