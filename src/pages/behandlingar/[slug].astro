---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidHuvud from '../../components/SidHuvud.astro';
import CtaSektion from '../../components/CtaSektion.astro';
import Sikte from '../../components/Sikte.astro';
import { TREATMENTS, CONDITIONS } from '../../lib/content';
import { breadcrumbSchema, treatmentSchema } from '../../lib/schema';
import { FEES } from '../../lib/site';

export function getStaticPaths() {
  return TREATMENTS.map((treatment) => ({
    params: { slug: treatment.slug },
    props: { treatment },
  }));
}

const { treatment } = Astro.props;

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Behandlingar', url: '/behandlingar/' },
  { name: treatment.name, url: `/behandlingar/${treatment.slug}/` },
];

const relaterade = treatment.relatedConditions
  .map((slug) => CONDITIONS.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const andraBehandlingar = TREATMENTS.filter((t) => t.slug !== treatment.slug).slice(0, 4);
---

<BaseLayout
  title={`${treatment.name} i Kristianstad | Apport`}
  description={treatment.metaDescription}
  schema={[breadcrumbSchema(crumbs), treatmentSchema(treatment)]}
>
  <SidHuvud
    etikett={treatment.inAgreement ? 'Behandling' : 'Behandling · utanför avtalet'}
    rubrik={treatment.heading}
    ingress={treatment.intro}
    {crumbs}
  />

  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid gap-16 py-(--spacing-section) lg:grid-cols-12">
      <div class="lg:col-span-7">
        {
          treatment.image && (
            <figure class="stig mb-14">
              <img
                src={treatment.image.src.replace(/\.(jpe?g|png)$/, '.webp')}
                alt={treatment.image.alt}
                loading="lazy"
                decoding="async"
                class="w-full rounded-2xl border border-sten"
              />
              <figcaption class="mt-4 text-[0.85rem] leading-relaxed text-skiffer">
                {treatment.image.caption}
              </figcaption>
            </figure>
          )
        }

        {
          treatment.sections.map((sektion) => (
            <section class="mb-14 last:mb-0">
              <h2 class="text-[1.6rem] leading-snug text-mossa-djup">{sektion.title}</h2>
              <div class="mt-5 space-y-5 text-[1.03rem] leading-relaxed text-skiffer">
                {sektion.body.map((stycke) => (
                  <p>{stycke}</p>
                ))}
              </div>
            </section>
          ))
        }

        <p
          class="mt-14 rounded-2xl border border-sten bg-lind/40 px-6 py-5 text-[0.96rem] leading-relaxed text-mossa-djup"
        >
          Om den här behandlingen är aktuell för dig avgörs av utredningen. Effekten varierar mellan
          patienter och beror på besvär, vävnad och förutsättningar — vi gör en bedömning i varje
          enskilt fall och lovar inget resultat i förväg.
        </p>
      </div>

      <aside class="lg:col-span-5">
        <div class="sticky top-32 space-y-6">
          <div class="rounded-2xl border border-sten bg-papper p-7">
            <h2 class="text-[1.15rem] text-mossa-djup">Bra att veta</h2>
            <ul class="mt-5 space-y-3.5">
              {
                treatment.goodToKnow.map((rad) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1 shrink-0 text-salvia-text">
                      <Sikte size={13} />
                    </span>
                    <span class="text-[0.94rem] leading-relaxed text-skiffer">{rad}</span>
                  </li>
                ))
              }
            </ul>

            <div class="mt-6 border-t border-sten pt-5">
              {
                treatment.inAgreement ? (
                  <p class="text-[0.9rem] leading-relaxed text-skiffer">
                    <strong class="font-semibold text-mossa-djup">Kostnad:</strong> patientavgift{' '}
                    {FEES.visit}. {FEES.visitNote}
                  </p>
                ) : (
                  <p class="text-[0.9rem] leading-relaxed text-skiffer">
                    <strong class="font-semibold text-tegel">Utanför avtalet:</strong>{' '}
                    {FEES.outsideAgreement}. Betalas av patienten själv.
                  </p>
                )
              }
            </div>
          </div>

          {
            relaterade.length > 0 && (
              <div class="rounded-2xl border border-sten bg-papper p-7">
                <h2 class="text-[1.15rem] text-mossa-djup">Används bland annat vid</h2>
                <ul class="mt-5 space-y-px overflow-hidden rounded-xl bg-sten">
                  {relaterade.map((c) => (
                    <li>
                      <a
                        href={`/besvar/${c.slug}/`}
                        class="group flex items-center justify-between gap-4 bg-papper px-5 py-4 transition-colors hover:bg-lind/50"
                      >
                        <span class="text-[0.95rem] text-mossa-djup">{c.name}</span>
                        <svg
                          width="14"
                          height="9"
                          viewBox="0 0 15 10"
                          fill="none"
                          aria-hidden="true"
                          class="shrink-0 text-mossa transition-transform duration-300 group-hover:translate-x-1"
                        >
                          <path
                            d="M0 5h13M9.5 1L13.5 5L9.5 9"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="rounded-2xl bg-mossa-djup p-7 text-kalk">
            <h2 class="text-[1.15rem]">Är detta något för dig?</h2>
            <p class="mt-3 text-[0.94rem] leading-relaxed text-kalk/72">
              Skriv några rader om dina besvär så tar vi ställning till vad som kan vara aktuellt.
            </p>
            <a
              href="/sa-gar-det-till/#egenremiss"
              class="mt-6 block rounded-full bg-kalk px-6 py-3 text-center text-[0.92rem] font-medium text-mossa-djup transition-colors hover:bg-lind"
            >
              Skriv en egenremiss
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <section class="bg-papper px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <h2 class="text-[1.7rem] text-mossa-djup">Andra behandlingar</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          andraBehandlingar.map((t) => (
            <li>
              <a
                href={`/behandlingar/${t.slug}/`}
                class="group flex h-full flex-col justify-between rounded-2xl border border-sten bg-kalk p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-salvia hover:shadow-mjuk"
              >
                <span class="text-[1.02rem] leading-snug text-mossa-djup">{t.name}</span>
                <span class="mt-5 text-[0.85rem] font-medium text-mossa transition-colors group-hover:text-tegel">
                  Läs mer →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSektion />
</BaseLayout>
