---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidHuvud from '../../components/SidHuvud.astro';
import CtaSektion from '../../components/CtaSektion.astro';
import Faq from '../../components/Faq.astro';
import SnabbKontakt from '../../components/SnabbKontakt.astro';
import { TREATMENTS, CONDITIONS } from '../../lib/content';
import { breadcrumbSchema, treatmentSchema, faqSchema } from '../../lib/schema';
import { SITE, CTA, PHONE_HOURS } from '../../lib/site';

export function getStaticPaths() {
  return TREATMENTS.map((treatment) => ({
    params: { slug: treatment.slug },
    props: { treatment },
  }));
}

const { treatment } = Astro.props;

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Behandlingar', url: '/behandlingar/' },
  { name: treatment.shortName, url: `/behandlingar/${treatment.slug}/` },
];

const relaterade = treatment.relatedConditions
  .map((slug) => CONDITIONS.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const andraBehandlingar = TREATMENTS.filter((t) => t.slug !== treatment.slug).slice(0, 4);
---

<BaseLayout
  title={`${treatment.metaTitle}`}
  description={treatment.metaDescription}
  schema={[breadcrumbSchema(crumbs), treatmentSchema(treatment), faqSchema(treatment.faqs)]}
>
  <SidHuvud
    etikett={treatment.inAgreement ? undefined : 'Utanför avtalet med Region Skåne'}
    rubrik={treatment.heading}
    ingress={treatment.intro}
    {crumbs}
  />

  <!-- Avtalsstatus direkt under sidhuvudet — patienten ska aldrig behöva leta -->
  <section
    class:list={[
      'border-b px-5 py-6 sm:px-8',
      treatment.inAgreement ? 'border-linje bg-mellan/40' : 'border-lera/25 bg-lera/8',
    ]}
  >
    <div class="mx-auto flex max-w-(--container-content) flex-wrap items-center gap-x-8 gap-y-3">
      <p class="flex items-center gap-2.5 text-[0.95rem] font-medium text-djup">
        <span class:list={[treatment.inAgreement ? 'text-lyft' : 'text-lera']}>
        </span>
        {
          treatment.inAgreement
            ? 'Ingår i avtalet med Region Skåne'
            : 'Ingår INTE i avtalet med Region Skåne'
        }
      </p>
      <p class="text-[0.95rem] text-dov">{treatment.cost}</p>
    </div>
  </section>

  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
    <div class="grid gap-16 py-(--spacing-rytm) lg:grid-cols-12">
      <div class="lg:col-span-7">
        {
          treatment.image && (
            <figure class="mb-14">
              <img
                src={treatment.image.src}
                alt={treatment.image.alt}
                width="1400"
                height="935"
                loading="lazy"
                decoding="async"
                class="w-full rounded-sm border border-linje"
              />
              <figcaption class="mt-4 text-[0.85rem] leading-relaxed text-dov">
                {treatment.image.caption}
              </figcaption>
            </figure>
          )
        }

        <!-- När kan det vara aktuellt -->
        <section class="scroll-mt-32">
          <h2 class="t-h2 text-djup">När kan det vara aktuellt?</h2>
          <ul class="mt-7 space-y-px overflow-hidden rounded-sm bg-linje">
            {
              treatment.whenRelevant.map((rad) => (
                <li class="bg-topp px-6 py-4.5">
                  <span class="t-brod text-djup">{rad}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Hur går det till -->
        <section class="mt-16">
          <h2 class="t-h2 text-djup">Hur går det till?</h2>
          {
            treatment.sections.map((sektion) => (
              <div class="mt-9">
                <h3 class="t-h3 text-djup">{sektion.title}</h3>
                <div class="mt-3 space-y-4 text-[1.03rem] leading-relaxed text-dov">
                  {sektion.body.map((stycke) => (
                    <p>{stycke}</p>
                  ))}
                </div>
              </div>
            ))
          }
        </section>

        <!-- Hur Apport arbetar -->
        <section class="mt-16">
          <h2 class="t-h2 text-djup">Hur vi arbetar med det</h2>
          <ul class="mt-7 space-y-5">
            {
              treatment.apportApproach.map((rad) => (
                <li class="flex items-start gap-4">
                  <span class="mt-1.5 shrink-0 text-dov">
                  </span>
                  <span class="text-[1.02rem] leading-relaxed text-dov">{rad}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- När är det inte lämpligt -->
        <section class="mt-16">
          <h2 class="t-h2 text-djup">När är det inte lämpligt?</h2>
          <ul class="mt-6 space-y-3">
            {
              treatment.notSuitable.map((rad) => (
                <li class="flex items-start gap-3.5 text-[1.01rem] leading-relaxed text-dov">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-lera" aria-hidden="true" />
                  {rad}
                </li>
              ))
            }
          </ul>
          <p
            class="mt-7 rounded-sm border border-linje bg-mellan/40 px-6 py-5 text-[0.96rem] leading-relaxed text-djup"
          >
            Vi bedömer i varje enskilt fall om en behandling är lämplig för dig, och går igenom
            vad den innebär innan den genomförs. Effekten varierar mellan patienter och beror på
            besvär, vävnad och förutsättningar — vi lovar inget resultat i förväg.
          </p>
        </section>

        <!-- FAQ -->
        <section class="mt-16">
          <h2 class="t-h2 text-djup">Vanliga frågor</h2>
          <Faq faqs={treatment.faqs} class="mt-8" />
        </section>
      </div>

      <!-- Sidospalt -->
      <aside class="lg:col-span-5">
        <div class="sticky top-32 space-y-6">
          <div
            class:list={[
              'rounded-sm border p-7',
              treatment.inAgreement ? 'border-linje bg-topp' : 'border-lera/25 bg-lera/6',
            ]}
          >
            <h2 class="t-h3 text-djup">Vad kostar det?</h2>
            <p
              class:list={[
                'mt-4 font-[family-name:var(--font-display)] text-[1.7rem] leading-tight',
                treatment.inAgreement ? 'text-lyft' : 'text-lera',
              ]}
            >
              {treatment.inAgreement ? '200 kr' : '2 000–2 500 kr'}
            </p>
            <p class="mt-3 text-[0.94rem] leading-relaxed text-dov">
              {
                treatment.inAgreement
                  ? 'Per besök. Frikort gäller. Betalning med kontant, faktura eller Swish.'
                  : 'Per behandling, betalas av dig själv. Vi går alltid igenom kostnaden innan behandlingen bokas.'
              }
            </p>
          </div>

          <div class="rounded-sm border border-linje bg-topp p-7">
            <h2 class="t-h3 text-djup">Bra att veta</h2>
            <ul class="mt-5 space-y-3.5">
              {
                treatment.goodToKnow.map((rad) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1 shrink-0 text-dov">
                    </span>
                    <span class="text-[0.94rem] leading-relaxed text-dov">{rad}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            relaterade.length > 0 && (
              <div class="rounded-sm border border-linje bg-topp p-7">
                <h2 class="t-h3 text-djup">Används bland annat vid</h2>
                <ul class="mt-5 space-y-px overflow-hidden rounded-sm bg-linje">
                  {relaterade.map((c) => (
                    <li>
                      <a
                        href={`/besvar/${c.slug}/`}
                        class="group flex items-center justify-between gap-4 bg-topp px-5 py-4 transition-colors hover:bg-mellan/50"
                      >
                        <span class="text-[0.95rem] text-djup">{c.name}</span>
                        <svg
                          width="14"
                          height="9"
                          viewBox="0 0 15 10"
                          fill="none"
                          aria-hidden="true"
                          class="shrink-0 text-lyft transition-transform duration-300 group-hover:translate-x-1"
                        >
                          <path
                            d="M0 5h13M9.5 1L13.5 5L9.5 9"
                            stroke="currentColor"
                            stroke-width="1.3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="rounded-sm bg-djup p-7 text-papper">
            <h2 class="t-h3">{CTA.relevance.label}</h2>
            <p class="mt-3 text-[0.94rem] leading-relaxed text-papper/72">
              Skriv några rader om dina besvär så tar vi ställning till vad som kan vara aktuellt.
              Du behöver ingen remiss.
            </p>
            <a
              href={CTA.primary.href}
              class="mt-6 block rounded-full bg-papper px-6 py-3 text-center text-[0.92rem] font-medium text-djup transition-colors hover:bg-mellan"
            >
              {CTA.primary.label}
            </a>
            <p class="mt-5 border-t border-papper/12 pt-4 text-[0.86rem] text-papper/58">
              Eller ring <a href={`tel:${SITE.phoneHref}`} class="lank-linje text-papper/85"
                >{SITE.phone}</a
              > — telefontid {PHONE_HOURS.toLowerCase()}.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <SnabbKontakt text="Undrar du om det här är relevant för dig? Fråga oss." />

  <section class="bg-topp px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <h2 class="t-h2 text-djup">Andra behandlingar</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          andraBehandlingar.map((t) => (
            <li>
              <a
                href={`/behandlingar/${t.slug}/`}
                class="group flex h-full flex-col justify-between rounded-sm border border-linje bg-papper p-6 transition-all duration-300 hover:border-ljus-dov"
              >
                <span class="text-[1.02rem] leading-snug text-djup">{t.shortName}</span>
                <span class="mt-5 text-[0.85rem] font-medium text-lyft transition-colors group-hover:text-lera">
                  Läs mer →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSektion />
</BaseLayout>
