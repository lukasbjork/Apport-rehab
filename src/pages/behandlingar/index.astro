---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidHuvud from '../../components/SidHuvud.astro';
import BehandlingKort from '../../components/BehandlingKort.astro';
import CtaSektion from '../../components/CtaSektion.astro';
import SektionsRubrik from '../../components/SektionsRubrik.astro';
import { TREATMENTS } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';
import { FEES } from '../../lib/site';

const title = 'Behandlingar — smärtbehandling i Kristianstad | Apport';
const description =
  'Smärtbehandling i Kristianstad: utredning med ultraljudsledda blockader, akupunktur, proloterapi, nervblockad, rotblockad, PRP, pulsad radiofrekvens och fysioterapi.';

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Behandlingar', url: '/behandlingar/' },
];

const iAvtal = TREATMENTS.filter((t) => t.inAgreement);
const utanforAvtal = TREATMENTS.filter((t) => !t.inAgreement);
---

<BaseLayout {title} {description} schema={[breadcrumbSchema(crumbs)]}>
  <SidHuvud
    rubrik="Från utredning till funktion"
    ingress="Alla smärttillstånd är unika och därför finns ingen standardbehandling. Vi kombinerar behandling och träning som samordnade insatser utifrån dina behov och mål — men först när utredningen visat vad problemet är."
    {crumbs}
  />

  <!--
    Klinikens egen viktigaste poäng, och den som saknades helt: det finns
    ingen quick fix. Den står först, eftersom allt nedanför läses annorlunda
    om man tagit den till sig.
  -->
  <section class="px-5 pt-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="max-w-(--container-läs) space-y-5 text-[1.04rem] leading-relaxed text-dov">
        <p class="text-djup">
          Det finns sällan någon quick fix vid långvarig smärta i nerver och rörelseapparat.
        </p>
        <p>
          Behandlingarna nedan är oftast inte smärtfria. De har dessutom sämre effekt, eller ingen
          alls, om de inte kombineras med träning som bygger styrka, balans och kroppskännedom.
        </p>
        <p>
          Långsiktig behandling, tålamod och sjukgymnastledd träning är grunden till de resultat vi
          får. Belöningen kommer ofta först efter fyra till sex månader.
        </p>
      </div>
    </div>
  </section>

  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik
        rubrik="Ingår i avtalet med Region Skåne"
        ingress={`Patientavgift ${FEES.visit} per besök. ${FEES.visitNote}`}
      />
      <div class="mt-12 grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {iAvtal.map((t) => <BehandlingKort treatment={t} />)}
      </div>
    </div>
  </section>

  <section class="bg-topp px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik
        rubrik="Utanför avtalet"
        ingress={FEES.outsideAgreementNote}
      />
      <div class="mt-12 grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {utanforAvtal.map((t) => <BehandlingKort treatment={t} />)}
      </div>
      <p class="mt-8 text-[0.94rem] text-dov">
        Kostnad: {FEES.outsideAgreement}. Vi går alltid igenom vad en behandling kostar innan den
        bokas.
      </p>
    </div>
  </section>

  <section class="px-5 pt-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="grid gap-10 rounded-sm bg-djup p-8 text-papper sm:p-14 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="t-h2">
            Regenerativ medicin: att hjälpa kroppen läka själv
          </h2>
          <p class="mt-6 text-[1.04rem] leading-relaxed text-papper/72">
            Kroppens självläkningsförmåga är fantastisk, men ibland behöver den hjälp. Flera av våra
            behandlingar bygger på samma grundtanke — att starta en process som kroppen sedan
            fullföljer själv.
          </p>
          <a
            href="/regenerativ-medicin/"
            class="mt-8 inline-block rounded-full bg-papper px-7 py-3.5 text-[0.95rem] font-medium text-djup transition-colors hover:bg-mellan"
          >
            Läs om regenerativ medicin
          </a>
        </div>
        <ul class="space-y-px overflow-hidden rounded-sm bg-papper/10 lg:col-span-6">
          {
            TREATMENTS.filter((t) => t.regenerative).map((t) => (
              <li>
                <a
                  href={`/behandlingar/${t.slug}/`}
                  class="block bg-djup px-6 py-5 transition-colors hover:bg-lyft"
                >
                  <span class="text-[1.02rem] text-papper">{t.name}</span>
                  <span class="mt-1 block text-[0.88rem] leading-relaxed text-papper/55">
                    {t.teaser}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaSektion />
</BaseLayout>
