---
import BaseLayout from '../layouts/BaseLayout.astro';
import SidHuvud from '../components/SidHuvud.astro';
import CtaSektion from '../components/CtaSektion.astro';
import SektionsRubrik from '../components/SektionsRubrik.astro';
import Referenser from '../components/Referenser.astro';
import { TEAM, NOT_OFFERED } from '../lib/content';
import { SITE } from '../lib/site';
import { breadcrumbSchema, personSchema } from '../lib/schema';

const title = 'Om Apport — smärtklinik i Kristianstad sedan 2010';
const description =
  'Apport är en privat smärtspecialistklinik i Kristianstad, driven av en läkare och en fysioterapeut sedan 2010. Läs om vårt arbetssätt, kliniken och personerna bakom.';

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Om Apport', url: '/om-apport/' },
];

const schema = [
  breadcrumbSchema(crumbs),
  ...TEAM.map((p) =>
    personSchema({
      name: p.name,
      role: p.role,
      url: `/om-apport/#${p.slug}`,
      credentials: p.credentials,
      specialties: p.specialties,
      // Endast Rolf är legitimerad läkare
      isPhysician: p.slug === 'rolf-jonsson',
    }),
  ),
];
---

<BaseLayout {title} {description} {schema}>
  <SidHuvud
    rubrik="En liten klinik med ovanligt mycket erfarenhet"
    ingress="Apport startades 2010 och drivs av två personer — en läkare och en fysioterapeut, gifta med varandra. Vi har varit fullbokade sedan starten, och har därför kunnat välja att göra färre saker men göra dem ordentligt."
    {crumbs}
  />

  <!-- Namnet -->
  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SektionsRubrik rubrik="Apport betyder ”hämta tillbaka”" />
        </div>
        <div class="space-y-5 text-[1.05rem] leading-relaxed text-dov lg:col-span-7">
          <p>
            <em class="not-italic font-medium text-djup">Apport</em> är franska och betyder
            ungefär ”hämta tillbaka, bär fram”. Det är en rimlig beskrivning av vad vi försöker göra:
            hämta tillbaka funktion som gått förlorad.
          </p>
          <p>
            Vi är specialistkliniken för dig med lokalt smärttillstånd. Alla smärttillstånd är unika
            och därför finns ingen standardbehandling — vi kombinerar behandling och
            träning/rehabilitering som samordnade insatser utifrån dina behov och mål.
          </p>
          <p>
            Vid undersökning och blockader används ultraljud, vilket höjer kvaliteten och kan ge
            snabbt svar på orsaken till din smärta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-(--container-content) px-5 sm:px-8"><div class=""></div></div>

  <!-- Arbetssätt -->
  <section id="arbetssatt" class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik
        rubrik="Över 60 års samlad erfarenhet av patienter som inte blivit hjälpta av det vanliga"
        ingress="Det förändrar hur man tänker. Inte så att man tror sig kunna allt — snarare tvärtom."
      />

      <div class="mt-14 grid gap-12 lg:grid-cols-2">
        <div class="space-y-5 text-[1.04rem] leading-relaxed text-dov">
          <p>
            När man tillsammans lagt över 60 år på att ta emot människor som redan varit på flera
            ställen lär man sig ett par saker. Den viktigaste är att smärta sällan sitter där man
            först tror, och att bilddiagnostik inte alltid räcker för att avgöra saken.
          </p>
          <p>
            Röntgen och magnetkamera visar hur kroppen ser ut. De visar inte alltid vad som gör ont.
            Många har förändringar på bild utan att ha besvär, och många har svåra besvär trots att
            bilderna ser fina ut.
          </p>
          <p>
            Därför lägger vi tid på att pröva oss fram med diagnostiska blockader i stället för att
            gissa. En struktur i taget, med ultraljud, och med effekten mätt på en skattningsskala.
          </p>
        </div>

        <div class="space-y-5 text-[1.04rem] leading-relaxed text-dov">
          <p>
            Den andra saken man lär sig är ödmjukhet. Alla går inte att hjälpa. En del smärttillstånd
            är sådana att det bästa vi kan göra är att säga det ärligt, tidigt, i stället för att
            fortsätta pröva.
          </p>
          <p>
            Det är också därför vi säger nej till en del. Vi tar inte emot {
              NOT_OFFERED.conditions.map((c) => c.toLowerCase()).join(', ')
            }. Det är ingen värdering av de besvären — de är verkliga och svåra. Det är en bedömning
            av vad just vår kompetens räcker till.
          </p>
          <p class="text-djup">
            Att avgränsa sig är förutsättningen för att kunna lägga ordentlig tid på de patienter vi
            faktiskt kan göra skillnad för.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Teamet -->
  <section class="bg-topp px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik rubrik="Personerna du möter" />

      <div class="mt-16 space-y-20">
        {
          TEAM.map((person, i) => (
            <article id={person.slug} class="scroll-mt-32 grid gap-10 lg:grid-cols-12">
              <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-2']}>
                {person.image ? (
                  <img
                    src={person.image}
                    alt={person.imageAlt}
                    width="800"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                    class="aspect-4/5 w-full rounded-sm border border-linje object-cover"
                  />
                ) : null}

                {/*
                  Ingen platshållarruta när fotot saknas. En stor grå ruta med
                  initialer är inte en bild — den är ett hål som låtsas vara en.
                  Kompetenserna får bära kolumnen tills kliniken levererat
                  porträtt; då byts de mot <img> ovan utan att layouten ändras.
                */}
                <ul class:list={['border-t border-linje', person.image && 'mt-6']}>
                  {person.specialties.map((sp) => (
                    <li class="t-liten border-b border-linje py-3 text-dov">{sp}</li>
                  ))}
                </ul>
              </div>

              <div class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-1']}>
                <h3 class="t-h2 text-djup">{person.name}</h3>
                <p class="mt-2 text-[1rem] font-medium text-dov">{person.role}</p>

                <div class="mt-6 space-y-4 text-[1.03rem] leading-relaxed text-dov">
                  {person.bio.map((stycke) => (
                    <p>{stycke}</p>
                  ))}
                </div>

                <details class="group mt-7 rounded-sm border border-linje bg-papper p-6">
                  <summary class="flex items-center justify-between gap-4 text-[0.95rem] font-medium text-djup">
                    <span>Utbildning och meriter</span>
                    <span
                      aria-hidden="true"
                      class="text-dov transition-transform duration-300 group-open:rotate-45"
                    >
                      <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                        <path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="1.4" />
                      </svg>
                    </span>
                  </summary>
                  <ul class="mt-5 space-y-2.5">
                    {person.credentials.map((rad) => (
                      <li class="flex items-start gap-3 text-[0.93rem] leading-relaxed text-dov">
                        <span class="mt-1 shrink-0 text-dov">
                        </span>
                        {rad}
                      </li>
                    ))}
                  </ul>
                </details>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Kliniken -->
  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SektionsRubrik
            rubrik="Andra våningen i ett hus från 1614"
          />
          <div class="mt-8 space-y-5 text-[1.03rem] leading-relaxed text-dov">
            <p>
              Kliniken finns på andra våningen på Borgmästaregården i Kristianstad, vid Stora Torg
              cirka 200 meter från resecentrum.
            </p>
            <p>
              Huset är ett av de äldsta i Kristianstad och har anor från 1614, när staden grundades.
              Lokalerna är renoverade i vår anda, samtidigt som vi försökt bevara husets prägel.
            </p>
            <p>Det finns hiss och handikapptoalett.</p>
            <p class="text-djup">
              Vår hund heter Laban. Husspöket heter herr Borg.
            </p>
          </div>

          <a
            href="/kontakt/"
            class="knapp knapp-mork mt-9"
          >
            Hitta hit
          </a>
        </div>

        <div class="lg:col-span-7">
          {/* Miljöbilden saknas fortfarande. Fakta får bära kolumnen så länge. */}
          <dl class="grid gap-6 border-t border-linje pt-8 sm:grid-cols-3">
            <div>
              <dt class="t-etikett text-dov">
                Grundad
              </dt>
              <dd class="mt-1.5 text-[1.05rem] text-djup">{SITE.founded}</dd>
            </div>
            <div>
              <dt class="t-etikett text-dov">
                Verksamhetschef
              </dt>
              <dd class="mt-1.5 text-[1.05rem] text-djup">{SITE.medicalDirector}</dd>
            </div>
            <div>
              <dt class="t-etikett text-dov">
                Uppdrag
              </dt>
              <dd class="mt-1.5 text-[1.05rem] text-djup">Region Skåne</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <Referenser />

  <CtaSektion />
</BaseLayout>
