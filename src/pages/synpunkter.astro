---
import BaseLayout from '../layouts/BaseLayout.astro';
import SidHuvud from '../components/SidHuvud.astro';
import { SITE } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const title = 'Synpunkter och klagomål | Apport Kristianstad';
const description =
  'Är du inte nöjd med vården hos Apport? Så här lämnar du synpunkter, och så här kontaktar du Patientnämnden Skåne eller IVO.';

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Synpunkter och klagomål', url: '/synpunkter/' },
];
---

<BaseLayout {title} {description} schema={[breadcrumbSchema(crumbs)]}>
  <SidHuvud
    rubrik="Synpunkter och klagomål"
    ingress="Om något inte blivit bra vill vi gärna veta det. Det är ofta så vi upptäcker sådant vi kan göra bättre — och du har dessutom rätt att få dina synpunkter besvarade."
    {crumbs}
  />

  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-läs) space-y-14">
      <div>
        <h2 class="t-h2 text-djup">Börja med att prata med oss</h2>
        <div class="mt-5 space-y-4 text-[1.03rem] leading-relaxed text-dov">
          <p>
            Enklast och snabbast är oftast att höra av dig direkt. Mejla <a
              href={`mailto:${SITE.email}`}
              class="lank-linje text-lyft">{SITE.email}</a
            > eller ring <a href={`tel:${SITE.phoneHref}`} class="lank-linje text-lyft"
              >{SITE.phone}</a
            > under telefontiden, så tar vi tag i det.
          </p>
          <p>
            Du behöver inte formulera dig på något särskilt sätt. Beskriv bara vad som hände och vad
            du tycker blev fel.
          </p>
        </div>
      </div>

      <div class="rounded-sm border border-linje bg-topp p-8">
        <h2 class="t-h2 text-djup">Patientnämnden Skåne</h2>
        <div class="mt-5 space-y-4 text-[1.02rem] leading-relaxed text-dov">
          <p>
            Du kan alltid vända dig till Patientnämnden Skåne om du vill ha hjälp med att lämna
            synpunkter eller klaga på vården. Det är kostnadsfritt och de har tystnadsplikt.
          </p>
          <p>
            Patientnämnden hanterar synpunkter som rör offentligt finansierad vård från Region Skåne,
            privata vårdgivare med avtal med Region Skåne, kommunal hälso- och sjukvård samt viss
            tandvård. Apport är en privat vårdgivare med avtal med Region Skåne, vilket innebär att
            nämnden kan hjälpa dig även i ärenden som rör oss.
          </p>
          <p>
            Nämnden hjälper dig att få svar på dina synpunkter och informerar om dina rättigheter i
            vården. De sammanställer också det som kommer in för att vården ska kunna förbättras.
          </p>
        </div>
        <a
          href="https://www.1177.se/Skane/sa-fungerar-varden/lamna-synpunkter-eller-klaga-pa-varden/"
          target="_blank"
          rel="noopener noreferrer"
          class="lank-linje mt-6 inline-block text-[0.98rem] font-medium text-lyft"
        >
          Läs mer om att lämna synpunkter på 1177.se
        </a>
      </div>

      <div>
        <h2 class="t-h2 text-djup">IVO — Inspektionen för vård och omsorg</h2>
        <div class="mt-5 space-y-4 text-[1.03rem] leading-relaxed text-dov">
          <p>
            Vid allvarligare händelser kan du anmäla till IVO, som är tillsynsmyndighet för hälso-
            och sjukvården. IVO utreder i första hand händelser som lett till bestående skada, ett
            väsentligt ökat vårdbehov eller att någon avlidit.
          </p>
          <p>
            IVO vill normalt att du först har vänt dig till vårdgivaren eller patientnämnden.
          </p>
        </div>
        <a
          href="https://www.ivo.se/"
          target="_blank"
          rel="noopener noreferrer"
          class="lank-linje mt-6 inline-block text-[0.98rem] font-medium text-lyft"
        >
          ivo.se
        </a>
      </div>

      <div>
        <h2 class="t-h2 text-djup">Din journal</h2>
        <p class="mt-5 text-[1.03rem] leading-relaxed text-dov">
          Du har rätt att läsa din journal. Kontakta oss på <a
            href={`mailto:${SITE.emailAdmin}`}
            class="lank-linje text-lyft">{SITE.emailAdmin}</a
          > så hjälper vi dig. Läs mer om hur vi hanterar personuppgifter på <a
            href="/integritetspolicy/"
            class="lank-linje text-lyft">sidan om personuppgifter</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
