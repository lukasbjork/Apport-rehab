---
/**
 * Startsidan — visuell omarbetning v3.
 *
 * Sektionsordningen följer §2, och varje sektion har medvetet en egen
 * visuell idé (§28):
 *
 *   Hero              mörk, asymmetrisk split, 88vh
 *   Statistikband     enorma siffror på hårlinjer
 *   Statement         bara typografi och luft
 *   Editorial split   bild som går utanför containern
 *   Marquee           långsam horisontell rörelse
 *   Besvär            numrerad lista med bildvisning vid hover
 *   Ultraljud         full bredd, mörk, bilden som hjälte
 *   Behandlingar      asymmetriskt rutnät, olika stora kort
 *   Region Skåne      förtroende, ljus
 *   Process           horisontell tidslinje
 *   Team              stora porträtt
 *   Omdömen           patientröster
 *   Selektiv          mörk, stort anslag
 *   Stor CTA          sand, affischlik
 *
 * Copyn är oförändrad (§25). Det är presentationen som är ny.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatistikBand from '../components/StatistikBand.astro';
import Statement from '../components/Statement.astro';
import EditorialSplit from '../components/EditorialSplit.astro';
import Marquee from '../components/Marquee.astro';
import BesvarLista from '../components/BesvarLista.astro';
import UltraljudHjalte from '../components/UltraljudHjalte.astro';
import BehandlingarGrid from '../components/BehandlingarGrid.astro';
import RegionSkane from '../components/RegionSkane.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import TeamStort from '../components/TeamStort.astro';
import SelektivSektion from '../components/SelektivSektion.astro';
import StorCta from '../components/StorCta.astro';
import Referenser from '../components/Referenser.astro';
import Patientfall from '../components/Patientfall.astro';
import RelevansGuide from '../components/RelevansGuide.astro';
import { ARTIKLAR_SORTERADE } from '../lib/artiklar-data';
import { clinicSchema, websiteSchema } from '../lib/schema';

const title = 'Smärtspecialist i Kristianstad | Apport';
const description =
  'Privat smärtspecialistklinik i Kristianstad sedan 2010. Vi utreder var smärtan kommer ifrån med ultraljudsledda blockader. Avtal med Region Skåne, inget remisstvång.';

const artiklar = ARTIKLAR_SORTERADE.slice(0, 3);
---

<BaseLayout {title} {description} overHero schema={[clinicSchema(), websiteSchema()]}>
  <Hero />

  <StatistikBand />

  <Statement
    eyebrow="Är det här du?"
    rubrik="Du har ont."
    rubrikAccent="Men du vill framför allt veta varför."
    brod="De flesta som kommer till oss har redan varit någon annanstans först. Ofta flera gånger. Det är sällan för att ingen har brytt sig — utan för att det är svårt att peka ut exakt vilken struktur som gör ont."
    cta={{ label: 'Se vilka besvär vi arbetar med', href: '/besvar/' }}
  />

  <EditorialSplit
    eyebrow="Det som gör Apport annorlunda"
    rubrik="Vi börjar med att förstå problemet."
    stycken={[
      'Röntgen och magnetkamera visar hur kroppen ser ut. Men de säger inte alltid vilken struktur som faktiskt bidrar till smärtan.',
      'Vi arbetar därför med klinisk undersökning, ultraljud och diagnostiska blockader när det är relevant — en struktur i taget, med effekten mätt på en skattningsskala.',
      'Först när vi har en rimlig bild av orsaken tar vi ställning till behandling, träning eller en kombination.',
    ]}
    bild={{
      src: '/bilder/blockad-facettled-landrygg.webp',
      alt: 'Anatomisk modell av ländryggen där en nål visar hur en facettledsblockad läggs mellan kotorna',
      caption:
        'Demonstration på anatomisk modell: så placeras nålen vid en facettledsblockad i ländryggen. På patient sker samma moment med ultraljud som vägledning.',
    }}
    cta={{ label: 'Så arbetar vi', href: '/om-apport/#arbetssatt' }}
  />

  <Marquee />

  <BesvarLista />

  <UltraljudHjalte />

  <BehandlingarGrid />

  <RegionSkane />

  <!-- Process -->
  <section class="bg-kalk py-(--spacing-sek-lg)">
    <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="t-eyebrow stig text-salvia-text">Så går det till</p>
        <h2 class="t-h2 stig mt-7 text-mossa-djup">Fyra steg, utan krångel</h2>
      </div>
      <div class="mt-16 lg:mt-20">
        <ProcessTimeline />
      </div>
    </div>
  </section>

  <TeamStort />

  <Referenser />

  <RelevansGuide />

  <Patientfall />

  <SelektivSektion />

  <!-- Artiklar -->
  <section class="bg-papper py-(--spacing-sek-lg)">
    <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <p class="t-eyebrow text-salvia-text">Artiklar</p>
          <h2 class="t-h2 mt-7 max-w-[16ch] text-mossa-djup">Sådant patienter ofta frågar om</h2>
        </div>
        <a href="/artiklar/" class="lank-linje pb-1 text-[0.94rem] font-medium text-mossa"
          >Alla artiklar →</a
        >
      </div>

      <ul class="mt-14 grid gap-px overflow-hidden rounded-sm bg-sten md:grid-cols-3">
        {
          artiklar.map((a) => (
            <li>
              <a
                href={`/artiklar/${a.slug}/`}
                class="stig group flex h-full flex-col justify-between bg-papper p-8 transition-colors duration-300 hover:bg-kalk"
              >
                <span>
                  <span class="flex items-center gap-2.5 text-[0.74rem] text-skiffer">
                    <span class="t-eyebrow text-[0.68rem] text-salvia-text">{a.amne}</span>
                    <span aria-hidden="true" class="text-sten-mork">·</span>
                    <span>{a.lastid} min</span>
                  </span>
                  <span class="t-h3 mt-5 block text-mossa-djup">{a.titel}</span>
                </span>
                <span
                  aria-hidden="true"
                  class="mt-10 text-mossa transition-transform duration-300 group-hover:translate-x-1"
                >
                  <svg width="18" height="11" viewBox="0 0 15 10" fill="none">
                    <path
                      d="M0 5h13M9.5 1L13.5 5L9.5 9"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <StorCta />
</BaseLayout>
