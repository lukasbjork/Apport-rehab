---
/**
 * Startsidan.
 *
 * Var 17 block på 17 378 px. Är nu 10 sektioner, och rytmen kommer från att
 * bottenfärgen växlar — inte från att varje sektion har en egen påhittad
 * visuell idé. Ordningen och vikten:
 *
 *   1  Hero               MÖRK      100svh, rubrik + ultraljudsbild
 *   2  Anslag             ljus      statement + de fyra nyckeltalen
 *   3  Så arbetar vi      ljusast   editorial split, bilden stor
 *   4  Klinikens bilder   MÖRK      galleri i stort format
 *   5  Besvär             mellan    hårlinjelista, två spalter
 *   6  Behandlingar       ljusast   asymmetriskt rutnät
 *   7  Fem steg           MÖRK      den enda numreringen på sidan
 *   7b Region Skåne       MÖRK      samma botten, läses som ett block
 *   8  Kliniken           ljus      teamet + omdömena
 *   9  Artiklar           mellan    hårlinjerader
 *  10  Egenremiss         MÖRK      affischlikt avslut
 *
 * SAMMANSLAGET: Statement + StatistikBand → Anslag. UltraljudHjalte →
 * Bildgalleri. ProcessTimeline + RegionSkane ligger på samma mörka botten.
 * TeamStort + Referenser → Kliniken.
 *
 * BORTTAGET: Marquee (dekoration utan informationsvärde, och dessutom ett
 * kontrastfel). Patientfall (renderade redan ingenting — listan är tom med
 * flit tills kliniken levererat godkända fall).
 *
 * FLYTTAT UT: SelektivSektion — dess innehåll fanns redan ordagrant som
 * #inte-ratt på /som-patient/, så det här var en ren dubblett.
 * RelevansGuide ligger kvar på /egenremiss/, där frågan "är jag rätt här?"
 * faktiskt ställs, i stället för att ta en sektion på startsidan.
 *
 * Copyn är oförändrad.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Anslag from '../components/Anslag.astro';
import EditorialSplit from '../components/EditorialSplit.astro';
import Bildgalleri from '../components/Bildgalleri.astro';
import BesvarLista from '../components/BesvarLista.astro';
import BehandlingarGrid from '../components/BehandlingarGrid.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import RegionSkane from '../components/RegionSkane.astro';
import Kliniken from '../components/Kliniken.astro';
import StorCta from '../components/StorCta.astro';
import { ARTIKLAR_SORTERADE } from '../lib/artiklar-data';
import { clinicSchema, websiteSchema } from '../lib/schema';

const title = 'Smärtspecialist i Kristianstad | Apport';
const description =
  'Privat smärtspecialistklinik i Kristianstad sedan 2010. Vi utreder var smärtan kommer ifrån med ultraljudsledda blockader. Avtal med Region Skåne, inget remisstvång.';

const artiklar = ARTIKLAR_SORTERADE.slice(0, 3);
---

<BaseLayout {title} {description} overHero schema={[clinicSchema(), websiteSchema()]}>
  <Hero />

  <Anslag />

  <EditorialSplit
    rubrik="Vi börjar med att förstå problemet."
    stycken={[
      'Röntgen och magnetkamera visar hur kroppen ser ut. Men de säger inte alltid vilken struktur som faktiskt bidrar till smärtan.',
      'Vi arbetar därför med klinisk undersökning, ultraljud och diagnostiska blockader när det är relevant — en struktur i taget, med effekten mätt på en skattningsskala.',
      'Först när vi har en rimlig bild av orsaken tar vi ställning till behandling, träning eller en kombination.',
    ]}
    bild={{
      src: '/bilder/blockad-facettled-landrygg.webp',
      alt: 'Anatomisk modell av ländryggen där en nål visar hur en facettledsblockad läggs mellan kotorna',
      caption:
        'Demonstration på anatomisk modell: så placeras nålen vid en facettledsblockad i ländryggen. På patient sker samma moment med ultraljud som vägledning.',
    }}
    cta={{ label: 'Så arbetar vi', href: '/om-apport/#arbetssatt' }}
  />

  <Bildgalleri />

  <BesvarLista />

  <BehandlingarGrid />

  <!--
    Fem steg och Region Skåne-avtalet ligger på samma mörka botten och
    läses därför som ett block: så går det till, och så betalar du.
  -->
  <section class="bg-djup px-5 pt-(--spacing-rytm-vid) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <h2 class="t-h2 max-w-[14ch] text-papper">Fem steg, utan krångel</h2>
      <div class="mt-14 lg:mt-16">
        <ProcessTimeline light />
      </div>
    </div>
  </section>

  <RegionSkane light />

  <Kliniken />

  <!-- Artiklar: hårlinjerader, ingen kortdesign, ingen lästid med mittprick -->
  <section class="bg-mellan/45 py-(--spacing-rytm)">
    <div class="mx-auto max-w-(--container-content) px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="t-h2 max-w-[16ch] text-djup">Sådant patienter ofta frågar om</h2>
        <a href="/artiklar/" class="lank-linje py-1 text-[0.95rem] font-medium text-lyft">
          Alla artiklar
        </a>
      </div>

      <ul class="mt-12 border-t border-djup/15 lg:mt-14">
        {
          artiklar.map((a) => (
            <li class="border-b border-djup/15">
              <a
                href={`/artiklar/${a.slug}/`}
                class="rad group flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 py-6 sm:px-2"
              >
                <span class="t-h3 max-w-[34ch] text-djup">{a.titel}</span>
                <span class="t-liten flex items-center gap-5 text-dov">
                  {a.amne}
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-300 group-hover:translate-x-1"
                  >
                    <svg width="18" height="11" viewBox="0 0 15 10" fill="none">
                      <path
                        d="M0 5h13M9.5 1L13.5 5L9.5 9"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <StorCta />
</BaseLayout>
