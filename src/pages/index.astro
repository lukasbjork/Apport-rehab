---
/**
 * Startsidan.
 *
 * Hålls medvetet kort. Den långa förklaringen av varför bilddiagnostik ofta
 * inte räcker låg tidigare här i fyra stycken — den bor nu i artikeln
 * "Röntgen visar inget men det gör ont", dit vi länkar i stället. Startsidan
 * ska få någon att känna igen sig och höra av sig, inte utbilda dem.
 *
 * Behandlingarna visas som en kompakt lista, inte som kort med brödtext.
 * Hela rutnätet finns på /behandlingar/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SektionsRubrik from '../components/SektionsRubrik.astro';
import BesvarKort from '../components/BesvarKort.astro';
import Process from '../components/Process.astro';
import CtaSektion from '../components/CtaSektion.astro';
import Referenser from '../components/Referenser.astro';
import Patientfall from '../components/Patientfall.astro';
import Sikte from '../components/Sikte.astro';
import BildPlatshallare from '../components/BildPlatshallare.astro';
import UltraljudSektion from '../components/UltraljudSektion.astro';
import Meriter from '../components/Meriter.astro';
import RelevansGuide from '../components/RelevansGuide.astro';
import SnabbKontakt from '../components/SnabbKontakt.astro';
import RegionSkane from '../components/RegionSkane.astro';
import Vagbrytare from '../components/Vagbrytare.astro';
import { CTA, TRUST_POINTS } from '../lib/site';
import { CONDITIONS, TREATMENTS, TEAM, NOT_OFFERED } from '../lib/content';
import { ARTIKLAR_SORTERADE, formateraDatum } from '../lib/artiklar-data';
import { clinicSchema, websiteSchema } from '../lib/schema';

const title = 'Smärtspecialist i Kristianstad | Apport';
const description =
  'Privat smärtspecialistklinik i Kristianstad sedan 2010. Vi utreder var smärtan kommer ifrån med ultraljudsledda blockader. Avtal med Region Skåne, inget remisstvång.';

const igenkanning = [
  'Du har haft ont länge',
  'Du har redan provat flera behandlingar',
  'Du har fått höra att allt ser normalt ut',
  'Du har en skada som aldrig riktigt blev bra',
  'Du vill förstå vad som faktiskt gör ont',
  'Du vill kunna träna eller fungera normalt igen',
];

const artiklar = ARTIKLAR_SORTERADE.slice(0, 3);
---

<BaseLayout {title} {description} schema={[clinicSchema(), websiteSchema()]}>
  <!-- ── Hero ────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-mossa-djup">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <img
        src="/bilder/pulsad-rf-2.webp"
        alt=""
        class="h-full w-full object-cover opacity-[0.13] mix-blend-screen"
        fetchpriority="high"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-mossa-djup via-mossa-djup/94 to-mossa-djup/60"
      >
      </div>
    </div>

    <div
      class="relative mx-auto grid max-w-(--container-content) gap-14 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-12 lg:py-36"
    >
      <div class="lg:col-span-7">
        <p
          class="flex items-center gap-2.5 text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-salvia"
        >
          <Sikte size={13} />
          Smärtspecialistklinik i Kristianstad
        </p>

        <h1 class="mt-7 text-[clamp(2.4rem,5.6vw,4.3rem)] leading-[1.02] text-kalk">
          Alla säger att det ser normalt ut.
          <span class="mt-1 block text-salvia">Ändå gör det ont.</span>
        </h1>

        <p class="mt-8 max-w-xl text-[1.14rem] leading-relaxed text-kalk/75">
          En bra behandling börjar inte alltid med en behandling. Den börjar
          med att ta reda på <em class="not-italic text-kalk">var</em> smärtan kommer ifrån.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={CTA.primary.href}
            class="rounded-full bg-kalk px-7 py-4 text-[0.98rem] font-medium text-mossa-djup transition-colors hover:bg-lind"
          >
            {CTA.primary.label}
          </a>
          <a
            href={CTA.secondary.href}
            class="rounded-full border border-kalk/25 px-7 py-4 text-[0.98rem] font-medium text-kalk transition-colors hover:border-kalk/60"
          >
            {CTA.secondary.label}
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2">
          {
            TRUST_POINTS.map((p, i) => (
              <li class="flex items-center gap-4 text-[0.88rem] text-kalk/58">
                {i > 0 && (
                  <span aria-hidden="true" class="text-kalk/25">
                    ·
                  </span>
                )}
                {p}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-5 lg:pl-6">
        <figure class="stig">
          <div class="overflow-hidden rounded-2xl border border-kalk/12">
            <img
              src="/bilder/ultraljud-c4-c5.webp"
              alt="Ultraljudsbild tagen på Apport som visar vävnadslagren i halsryggen, med markörer vid de strukturer som bedömts"
              width="640"
              height="430"
              class="w-full"
              decoding="async"
            />
          </div>
          <figcaption class="mt-4 text-[0.84rem] leading-relaxed text-kalk/58">
            Ultraljudsbild från kliniken — så avgör vi vilken struktur som bidrar till smärtan.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Är det här du? ──────────────────────────────────────── -->
  <section class="px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto grid max-w-(--container-content) gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SektionsRubrik
          etikett="Är det här du?"
          rubrik="Du har ont. Men du vill framför allt veta varför."
          ingress="De flesta som kommer till oss har redan varit någon annanstans först. Ofta flera gånger."
        />
        <a
          href="/besvar/"
          class="mt-9 inline-flex items-center gap-2 rounded-full bg-mossa px-7 py-3.5 text-[0.95rem] font-medium text-kalk transition-colors hover:bg-mossa-djup"
        >
          Se vilka besvär vi arbetar med
        </a>
      </div>

      <div class="lg:col-span-7">
        <ul class="stig grid gap-x-10 gap-y-5 sm:grid-cols-2">
          {
            igenkanning.map((rad) => (
              <li class="flex items-start gap-3.5 border-b border-sten pb-5">
                <span class="mt-0.5 shrink-0 text-mossa" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 17 17" fill="none">
                    <path
                      d="M3 9l3.6 3.6L14 5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="text-[1.04rem] leading-snug text-mossa-djup">{rad}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Bakom Apport — högt upp, för att det är det personliga ─ -->
  <section class="bg-papper px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik
        etikett="Bakom Apport"
        rubrik="Samma två personer sedan 2010"
        ingress="En läkare och en fysioterapeut, gifta med varandra. Du möter samma personer varje gång, och de pratar med varandra om ditt fall."
      />

      <div class="mt-14 grid gap-8 sm:grid-cols-2">
        {
          TEAM.map((person) => (
            <article class="stig">
              {person.image ? (
                <img
                  src={person.image}
                  alt={person.imageAlt}
                  width="800"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                  class="aspect-4/5 w-full rounded-2xl object-cover"
                />
              ) : (
                <BildPlatshallare
                  behov={`Porträtt av ${person.name}`}
                  monogram={person.name
                    .split(' ')
                    .map((n) => n[0])
                    .join('')}
                  ratio="aspect-4/5"
                />
              )}
              <h3 class="mt-6 text-[1.35rem] text-mossa-djup">{person.name}</h3>
              <p class="mt-1 text-[0.9rem] font-medium text-mossa-ljus">{person.role}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {person.specialties.map((sp) => (
                  <li class="rounded-full bg-lind/70 px-3 py-1.5 text-[0.8rem] text-mossa-djup">
                    {sp}
                  </li>
                ))}
              </ul>
              <a
                href={`/om-apport/#${person.slug}`}
                class="lank-linje mt-5 inline-block py-1 text-[0.9rem] font-medium text-mossa"
              >
                Läs mer om {person.name.split(' ')[0]}
              </a>
            </article>
          ))
        }
      </div>

      <div class="mt-14">
        <Meriter />
      </div>
    </div>
  </section>

  <!-- ── Ultraljud som USP ───────────────────────────────────── -->
  <UltraljudSektion />

  <!-- ── Region Skåne ────────────────────────────────────────── -->
  <RegionSkane />

  <!-- ── Besvär ──────────────────────────────────────────────── -->
  <section class="px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik
        etikett="Besvär"
        rubrik="Vilken typ av smärta söker du hjälp för?"
      />

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {CONDITIONS.map((c, i) => <BesvarKort condition={c} wide={i === 0} compact />)}
      </div>
    </div>
  </section>

  <SnabbKontakt text="Känner du igen dig? Berätta kort om dina besvär så säger vi om vi kan hjälpa." />

  <!-- ── Behandlingar: kompakt lista, hela rutnätet finns på undersidan ── -->
  <section class="px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SektionsRubrik
            etikett="Behandlingar"
            rubrik="Från utredning till funktion"
            ingress="Alla smärttillstånd är unika, så det finns ingen standardbehandling. Vad som blir aktuellt avgörs av vad utredningen visar."
          />
          <a
            href="/behandlingar/"
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-mossa px-7 py-3.5 text-[0.95rem] font-medium text-kalk transition-colors hover:bg-mossa-djup"
          >
            Se alla behandlingar
          </a>
        </div>

        <ul class="divide-y divide-sten border-y border-sten lg:col-span-7">
          {
            TREATMENTS.map((t) => (
              <li>
                <a
                  href={`/behandlingar/${t.slug}/`}
                  class="group flex items-center justify-between gap-5 py-4.5"
                >
                  <span class="text-[1.05rem] text-mossa-djup transition-colors group-hover:text-mossa">
                    {t.shortName}
                    {!t.inAgreement && (
                      <span class="ml-2.5 rounded-full bg-tegel/10 px-2.5 py-1 align-middle text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-tegel">
                        Utanför avtalet
                      </span>
                    )}
                  </span>
                  <svg
                    width="15"
                    height="10"
                    viewBox="0 0 15 10"
                    fill="none"
                    aria-hidden="true"
                    class="shrink-0 text-mossa transition-transform duration-300 group-hover:translate-x-1"
                  >
                    <path
                      d="M0 5h13M9.5 1L13.5 5L9.5 9"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Vagbrytare fran="kalk" till="papper" />

  <!-- ── Relevansguide ───────────────────────────────────────── -->
  <div class="bg-papper">
    <RelevansGuide />
  </div>

  <!-- ── Så går det till ─────────────────────────────────────── -->
  <section class="bg-papper px-5 pb-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik etikett="Så går det till" rubrik="Fyra steg, utan krångel" />
      <div class="mt-14">
        <Process />
      </div>
    </div>
  </section>

  <!-- ── Vad vi inte gör ─────────────────────────────────────── -->
  <section class="px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="grid gap-12 rounded-[2rem] bg-lind/45 p-8 sm:p-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SektionsRubrik
            etikett="Ärligt talat"
            rubrik="Vi tar inte emot allt"
            ingress="Vi är två personer. Att säga nej till det vi inte är bäst på är förutsättningen för att hinna med det vi kan."
          />
        </div>

        <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7">
          <div>
            <h3 class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-mossa-ljus">
              Besvär vi inte utreder
            </h3>
            <ul class="mt-4 space-y-2.5 text-[0.96rem] text-skiffer">
              {NOT_OFFERED.conditions.map((rad) => <li>{rad}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-mossa-ljus">
              Sådant vi inte utfärdar
            </h3>
            <ul class="mt-4 space-y-2.5 text-[0.96rem] text-skiffer">
              {NOT_OFFERED.services.map((rad) => <li>{rad}</li>)}
            </ul>
          </div>

          <p class="text-[0.94rem] leading-relaxed text-skiffer sm:col-span-2">
            Osäker på om vi är rätt? Skriv ändå — vi säger till om någon annan passar bättre.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Artiklar ────────────────────────────────────────────── -->
  <section class="bg-papper px-5 py-(--spacing-section) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SektionsRubrik etikett="Artiklar" rubrik="Sådant patienter ofta frågar om" />
        <a
          href="/artiklar/"
          class="lank-linje py-1 text-[0.94rem] font-medium text-mossa">Alla artiklar →</a
        >
      </div>

      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {
          artiklar.map((a) => (
            <li>
              <a
                href={`/artiklar/${a.slug}/`}
                class="stig group flex h-full flex-col justify-between rounded-2xl bg-kalk p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-mjuk"
              >
                <span>
                  <span class="flex items-center gap-2.5 text-[0.72rem] text-skiffer">
                    <span class="font-semibold uppercase tracking-[0.14em] text-salvia-text">
                      {a.amne}
                    </span>
                    <span aria-hidden="true" class="text-sten-mork">
                      ·
                    </span>
                    <span>{a.lastid} min</span>
                  </span>
                  <span class="mt-3 block text-[1.14rem] leading-snug text-mossa-djup">
                    {a.titel}
                  </span>
                </span>
                <span class="mt-6 text-[0.85rem] font-medium text-mossa transition-colors group-hover:text-tegel">
                  Läs mer →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Patientfall />

  <Referenser />

  <CtaSektion />
</BaseLayout>
