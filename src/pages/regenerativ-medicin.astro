---
import BaseLayout from '../layouts/BaseLayout.astro';
import SidHuvud from '../components/SidHuvud.astro';
import CtaSektion from '../components/CtaSektion.astro';
import SektionsRubrik from '../components/SektionsRubrik.astro';
import BehandlingKort from '../components/BehandlingKort.astro';
import { TREATMENTS } from '../lib/content';
import { breadcrumbSchema } from '../lib/schema';

const title = 'Regenerativ medicin i Kristianstad | Apport';
const description =
  'Regenerativ medicin i Kristianstad: dry needling, proloterapi och PRP. Metoder som kan aktivera kroppens egen läkningsförmåga vid skadad vävnad.';

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Regenerativ medicin', url: '/regenerativ-medicin/' },
];

const regenerativa = TREATMENTS.filter((t) => t.regenerative);

const steg = [
  {
    rubrik: 'En kontrollerad retning',
    text: 'Behandlingen skapar avsiktligt en liten, avgränsad retning i vävnaden — med en nål, ett retande ämne eller kroppens egna blodplättar.',
  },
  {
    rubrik: 'Immunsystemet svarar',
    text: 'Retningen aktiverar immunsystemet. Först uppstår en inflammation, därefter frisätts bland annat tillväxt- och komplementfaktorer.',
  },
  {
    rubrik: 'Vävnaden byggs om',
    text: 'En kedjereaktion startas med inflammation, vävnadsnybildning (proliferation) och omformning av vävnaden.',
  },
];
---

<BaseLayout {title} {description} schema={[breadcrumbSchema(crumbs)]}>
  <SidHuvud
    rubrik="Regenerativ medicin"
    ingress="Kroppens självläkningsförmåga är fantastisk, men ibland behöver den hjälp. Regenerativ medicin är ett samlingsnamn för metoder som syftar till att starta en läkningsprocess i vävnad som inte läkt av sig själv."
    {crumbs}
  />

  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SektionsRubrik rubrik="Grundtanken" />
        </div>
        <div class="space-y-5 text-[1.05rem] leading-relaxed text-dov lg:col-span-7">
          <p>
            Vissa vävnader läker dåligt på egen hand. Senfästen och ligament har till exempel
            begränsad blodförsörjning, vilket gör att en skada där kan bli kvar i åratal utan att
            kroppen kommer vidare i läkningsprocessen.
          </p>
          <p>
            Regenerativ behandling går ut på att sätta igång den processen igen. Det låter
            motsägelsefullt, men metoden bygger på att skapa en kontrollerad retning — en liten,
            avsiktlig påverkan som får immunsystemet att börja arbeta i området.
          </p>
          <p class="text-djup">
            Det är därför det ofta gör mer ont innan det gör mindre ont. Vid proloterapi upplever
            många patienter ökad smärta dag 2–4 efter behandlingen. Det hänger ihop med den
            inflammation som är själva poängen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-topp px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik rubrik="Tre steg i samma kedja" />
      <ol class="mt-14 grid gap-px overflow-hidden rounded-sm bg-linje sm:grid-cols-3">
        {
          steg.map((s, i) => (
            <li class="bg-papper p-8">
              <span class="font-[family-name:var(--font-display)] text-[2.4rem] leading-none text-dov">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="t-h3 mt-5 text-djup">{s.rubrik}</h3>
              <p class="mt-3 text-[0.94rem] leading-relaxed text-dov">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <SektionsRubrik
        rubrik="Våra regenerativa behandlingar"
        ingress="Vilken metod som är aktuell — och om någon av dem alls är det — avgörs av utredningen."
      />
      <div class="mt-14 grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {regenerativa.map((t) => <BehandlingKort treatment={t} />)}
      </div>
    </div>
  </section>

  <section class="px-5 pb-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <div class="rounded-sm border border-linje bg-mellan/35 p-8 sm:p-12">
        <h2 class="t-h2 text-djup">Vad vi inte påstår</h2>
        <div class="mt-5 max-w-(--container-läs) space-y-4 text-[1rem] leading-relaxed text-dov">
          <p>
            Regenerativ medicin är ett område där det förekommer stora löften. Vi håller oss till
            det vi kan stå för: metoderna syftar till att aktivera kroppens egen läkningsförmåga,
            och för vissa patienter fungerar det bra.
          </p>
          <p>
            Vi lovar inte bot, garanterar inte resultat och påstår inte att metoderna fungerar för
            alla. Om vi bedömer att en behandling sannolikt inte hjälper dig säger vi det hellre än
            att pröva ändå.
          </p>
          <p class="text-djup">
            PRP och pulsad radiofrekvens ingår inte i vårt avtal med Region Skåne och betalas av dig
            själv. Vi går alltid igenom kostnaden innan något bokas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaSektion />
</BaseLayout>
