---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidHuvud from '../../components/SidHuvud.astro';
import SnabbKontakt from '../../components/SnabbKontakt.astro';
import CtaSektion from '../../components/CtaSektion.astro';
import { ARTIKLAR_SORTERADE, formateraDatum } from '../../lib/artiklar-data';
import { TEAM } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/schema';

const title = 'Artiklar om smärta och utredning | Apport';
const description =
  'Texter om hur vi utreder smärta, varför röntgen ofta inte räcker och när det är läge att söka hjälp. Skrivna av läkaren och fysioterapeuten på Apport i Kristianstad.';

const crumbs = [
  { name: 'Hem', url: '/' },
  { name: 'Artiklar', url: '/artiklar/' },
];

const namn = (slug: string) => TEAM.find((t) => t.slug === slug)?.name ?? '';
const [forsta, ...ovriga] = ARTIKLAR_SORTERADE;
---

<BaseLayout {title} {description} schema={[breadcrumbSchema(crumbs)]}>
  <SidHuvud
    etikett="Artiklar"
    rubrik="Om smärta, utredning och vad som faktiskt hjälper"
    ingress="Vi skriver om sådant patienter ofta frågar om — varför bilddiagnostik kan se normal ut fast det gör ont, hur en diagnostisk blockad går till, och när det är läge att söka hjälp."
    {crumbs}
  />

  <!-- Framhävd artikel -->
  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <a
        href={`/artiklar/${forsta.slug}/`}
        class="group grid gap-10 lg:grid-cols-12 lg:items-center"
      >
        {
          forsta.image && (
            <div class="overflow-hidden rounded-2xl lg:col-span-6">
              <img
                src={forsta.image.src}
                alt={forsta.image.alt}
                width="1400"
                height="940"
                class="aspect-16/11 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                decoding="async"
              />
            </div>
          )
        }
        <div class:list={[forsta.image ? 'lg:col-span-6' : 'lg:col-span-8']}>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.78rem] text-dov">
            <span class="font-semibold uppercase tracking-[0.14em] text-dov"
              >{forsta.amne}</span
            >
            <span aria-hidden="true" class="text-linje">·</span>
            <time datetime={forsta.datum}>{formateraDatum(forsta.datum)}</time>
            <span aria-hidden="true" class="text-linje">·</span>
            <span>{forsta.lastid} min läsning</span>
          </p>

          <h2
            class="mt-4 text-[clamp(1.7rem,3.2vw,2.5rem)] leading-[1.13] text-djup transition-colors group-hover:text-lyft"
          >
            {forsta.titel}
          </h2>
          <p class="mt-5 text-[1.06rem] leading-relaxed text-dov">{forsta.ingress}</p>
          <p class="mt-5 text-[0.9rem] text-dov">Av {namn(forsta.forfattare)}</p>

          <span
            class="mt-7 inline-flex items-center gap-2 text-[0.92rem] font-medium text-lyft transition-colors group-hover:text-lera"
          >
            Läs artikeln
            <svg
              width="15"
              height="10"
              viewBox="0 0 15 10"
              fill="none"
              aria-hidden="true"
              class="transition-transform duration-300 group-hover:translate-x-1"
            >
              <path
                d="M0 5h13M9.5 1L13.5 5L9.5 9"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <SnabbKontakt text="Har du en fråga som inte besvaras här? Skriv några rader så svarar vi." />

  <!-- Övriga artiklar -->
  <section class="px-5 py-(--spacing-rytm) sm:px-8">
    <div class="mx-auto max-w-(--container-content)">
      <h2 class="text-[1.7rem] text-djup">Fler artiklar</h2>

      <ul class="mt-10 divide-y divide-linje border-y border-linje">
        {
          ovriga.map((a) => (
            <li>
              <a href={`/artiklar/${a.slug}/`} class="group grid gap-4 py-8 md:grid-cols-12 md:gap-8">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.78rem] text-dov md:col-span-3 md:block">
                  <span class="font-semibold uppercase tracking-[0.14em] text-dov">
                    {a.amne}
                  </span>
                  <span aria-hidden="true" class="text-linje md:hidden">
                    ·
                  </span>
                  <time datetime={a.datum} class="md:mt-1.5 md:block">
                    {formateraDatum(a.datum)}
                  </time>
                  <span aria-hidden="true" class="text-linje md:hidden">
                    ·
                  </span>
                  <span class="md:mt-0.5 md:block">{a.lastid} min läsning</span>
                </p>

                <div class="md:col-span-9">
                  <h3 class="text-[1.32rem] leading-snug text-djup transition-colors group-hover:text-lyft">
                    {a.titel}
                  </h3>
                  <p class="mt-2.5 max-w-(--container-läs) text-[0.99rem] leading-relaxed text-dov">
                    {a.ingress}
                  </p>
                  <p class="mt-3 text-[0.86rem] text-dov">Av {namn(a.forfattare)}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSektion />
</BaseLayout>
